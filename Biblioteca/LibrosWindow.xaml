<Window x:Class="LibrosWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="Biblioteca - Administración de Libros"
        Height="730" Width="1120"
        MinHeight="640" MinWidth="920"
        WindowStartupLocation="CenterScreen"
        Background="#F7F6F2"
        FontFamily="Segoe UI">

    <Window.Resources>
        <!-- Estilo para botones tipo enlace / transparentes -->
        <Style x:Key="LinkButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="BorderElem" Background="{TemplateBinding Background}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="BorderElem" Property="Opacity" Value="0.4"/>
                                <Setter Property="Cursor" Value="Arrow"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Estilo para botones del menú lateral -->
        <Style x:Key="SidebarButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="14,10,14,10"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="HorizontalContentAlignment" Value="Left"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="BorderElem"
                                Background="{TemplateBinding Background}"
                                CornerRadius="8"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="BorderElem" Property="Background" Value="#EDECE7"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Estilo para botón primario verde -->
        <Style x:Key="PrimaryGreenButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="#1D3B31"/>
            <Setter Property="Foreground" Value="#FFFFFF"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="BtnBorder"
                                Background="{TemplateBinding Background}"
                                CornerRadius="8"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="BtnBorder" Property="Background" Value="#254A3E"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="BtnBorder" Property="Background" Value="#142821"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="BtnBorder" Property="Opacity" Value="0.6"/>
                                <Setter Property="Cursor" Value="Arrow"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Estilo para botón secundario contorneado (blanco con borde gris) -->
        <Style x:Key="OutlinedActionButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="#FFFFFF"/>
            <Setter Property="Foreground" Value="#374151"/>
            <Setter Property="BorderBrush" Value="#D1D5DB"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Height" Value="32"/>
            <Setter Property="Width" Value="96"/>
            <Setter Property="FontSize" Value="12.5"/>
            <Setter Property="FontWeight" Value="Medium"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="BtnBorder"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="6">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="BtnBorder" Property="Background" Value="#F9FAFB"/>
                                <Setter TargetName="BtnBorder" Property="BorderBrush" Value="#9CA3AF"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="BtnBorder" Property="Background" Value="#F3F4F6"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="BtnBorder" Property="Opacity" Value="0.5"/>
                                <Setter Property="Cursor" Value="Arrow"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Estilo para botón de peligro / eliminación (rojo suave) -->
        <Style x:Key="DangerActionButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="#FEF2F2"/>
            <Setter Property="Foreground" Value="#DC2626"/>
            <Setter Property="BorderBrush" Value="#FECACA"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Height" Value="32"/>
            <Setter Property="Width" Value="96"/>
            <Setter Property="FontSize" Value="12.5"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="BtnBorder"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="6">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="BtnBorder" Property="Background" Value="#FEE2E2"/>
                                <Setter TargetName="BtnBorder" Property="BorderBrush" Value="#F87171"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="BtnBorder" Property="Background" Value="#FCA5A5"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="BtnBorder" Property="Opacity" Value="0.5"/>
                                <Setter Property="Cursor" Value="Arrow"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Estilo para campos de formulario -->
        <Style x:Key="FormFieldTextBoxStyle" TargetType="TextBox">
            <Setter Property="Height" Value="42"/>
            <Setter Property="Background" Value="#FFFFFF"/>
            <Setter Property="BorderBrush" Value="#D1D5DB"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="FontSize" Value="13.5"/>
            <Setter Property="Foreground" Value="#111827"/>
            <Setter Property="Padding" Value="12,0,12,0"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border x:Name="Border"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="8">
                            <ScrollViewer x:Name="PART_ContentHost" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Border" Property="BorderBrush" Value="#9CA3AF"/>
                            </Trigger>
                            <Trigger Property="IsFocused" Value="True">
                                <Setter TargetName="Border" Property="BorderBrush" Value="#1D3B31"/>
                                <Setter TargetName="Border" Property="BorderThickness" Value="1.5"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <!-- Barra Lateral Izquierda -->
            <ColumnDefinition Width="225"/>
            <!-- Área Principal de Contenido -->
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- ================= PANEL LATERAL ================= -->
        <Border Grid.Column="0"
                Background="#F7F6F2"
                BorderBrush="#E5E7EB"
                BorderThickness="0,0,1,0">
            <Grid Margin="20,22,20,22">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- Header de Marca (Logo y Título) -->
                <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="4,0,0,32">
                    <Border Width="38" Height="38"
                            Background="#1D3B31"
                            CornerRadius="8"
                            VerticalAlignment="Center">
                        <Path Data="M3 4.5A2.5 2.5 0 0 1 5.5 2H10a3 3 0 0 1 3 3v13.5a2.5 2.5 0 0 0-2.5-2H5.5A2.5 2.5 0 0 0 3 19V4.5z M21 4.5A2.5 2.5 0 0 0 18.5 2H14a3 3 0 0 0-3 3v13.5a2.5 2.5 0 0 1 2.5-2h5A2.5 2.5 0 0 1 21 19V4.5z"
                              Stroke="#FFFFFF"
                              StrokeThickness="1.6"
                              Fill="Transparent"
                              StrokeStartLineCap="Round"
                              StrokeEndLineCap="Round"
                              StrokeLineJoin="Round"
                              Stretch="Uniform"
                              Width="18" Height="18"
                              HorizontalAlignment="Center"
                              VerticalAlignment="Center"/>
                    </Border>
                    <StackPanel Margin="12,0,0,0" VerticalAlignment="Center">
                        <TextBlock Text="Biblioteca"
                                   FontSize="15"
                                   FontWeight="Bold"
                                   Foreground="#111827"/>
                        <TextBlock Text="Sistema de gestión"
                                   FontSize="11.5"
                                   Foreground="#6B7280"
                                   Margin="0,1,0,0"/>
                    </StackPanel>
                </StackPanel>

                <!-- Menú de Navegación Lateral -->
                <StackPanel Grid.Row="1" Margin="0,4,0,0">
                    <!-- Opción 1: Agregar libro (Activo por defecto) -->
                    <Button x:Name="btnNavAgregarLibro"
                            Style="{StaticResource SidebarButtonStyle}"
                            Background="#EBF3EF"
                            Margin="0,0,0,6"
                            Click="BtnNavAgregarLibro_Click">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <!-- Icono Agregar (cuadrado con cruz / libro con más) -->
                            <Path x:Name="iconNavAgregarLibro"
                                  Data="M19 3H5a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2V5a2 2 0 0 0-2-2z M12 8v8 M8 12h8"
                                  Stroke="#1D3B31"
                                  StrokeThickness="1.8"
                                  StrokeStartLineCap="Round"
                                  StrokeEndLineCap="Round"
                                  Stretch="Uniform"
                                  Width="15" Height="15"
                                  Margin="0,0,10,0"
                                  VerticalAlignment="Center"/>
                            <TextBlock x:Name="textNavAgregarLibro"
                                       Text="Agregar libro"
                                       FontSize="13.5"
                                       FontWeight="SemiBold"
                                       Foreground="#1D3B31"
                                       VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>

                    <!-- Opción 2: Modificar libro -->
                    <Button x:Name="btnNavModificarLibro"
                            Style="{StaticResource SidebarButtonStyle}"
                            Background="Transparent"
                            Margin="0,0,0,6"
                            Click="BtnNavModificarLibro_Click">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <!-- Icono Modificar / Edición (lápiz) -->
                            <Path x:Name="iconNavModificarLibro"
                                  Data="M11 4H4a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2v-7 M18.5 2.5a2.121 2.121 0 0 1 3 3L12 15l-4 1 1-4 9.5-9.5z"
                                  Stroke="#4B5563"
                                  StrokeThickness="1.8"
                                  StrokeStartLineCap="Round"
                                  StrokeEndLineCap="Round"
                                  StrokeLineJoin="Round"
                                  Stretch="Uniform"
                                  Width="15" Height="15"
                                  Margin="0,0,10,0"
                                  VerticalAlignment="Center"/>
                            <TextBlock x:Name="textNavModificarLibro"
                                       Text="Modificar libro"
                                       FontSize="13.5"
                                       Foreground="#4B5563"
                                       VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>

                    <!-- Opción 3: Eliminar libro -->
                    <Button x:Name="btnNavEliminarLibro"
                            Style="{StaticResource SidebarButtonStyle}"
                            Background="Transparent"
                            Margin="0,0,0,6"
                            Click="BtnNavEliminarLibro_Click">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <!-- Icono Eliminar / Papelera -->
                            <Path x:Name="iconNavEliminarLibro"
                                  Data="M3 6h18 M19 6v14a2 2 0 0 1-2 2H7a2 2 0 0 1-2-2V6 M8 6V4a2 2 0 0 1 2-2h4a2 2 0 0 1 2 2v2 M10 11v6 M14 11v6"
                                  Stroke="#4B5563"
                                  StrokeThickness="1.8"
                                  StrokeStartLineCap="Round"
                                  StrokeEndLineCap="Round"
                                  StrokeLineJoin="Round"
                                  Stretch="Uniform"
                                  Width="15" Height="15"
                                  Margin="0,0,10,0"
                                  VerticalAlignment="Center"/>
                            <TextBlock x:Name="textNavEliminarLibro"
                                       Text="Eliminar libro"
                                       FontSize="13.5"
                                       Foreground="#4B5563"
                                       VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                </StackPanel>

                <!-- Pie de Menú Lateral -->
                <TextBlock Grid.Row="2"
                           Text="Biblioteca · Gestión bibliotecaria"
                           FontSize="11.5"
                           Foreground="#9CA3AF"
                           Margin="6,0,0,4"/>
            </Grid>
        </Border>

        <!-- ================= CONTENIDO PRINCIPAL ================= -->
        <ScrollViewer Grid.Column="1"
                      x:Name="scrollPrincipal"
                      VerticalScrollBarVisibility="Auto"
                      HorizontalScrollBarVisibility="Disabled">
            <Grid Margin="48,26,48,36"
                  MaxWidth="960"
                  HorizontalAlignment="Stretch">

                <!-- ================= VISTA 1: AGREGAR LIBRO ================= -->
                <Grid x:Name="gridAgregarLibro" Visibility="Visible">
                    <Grid.RowDefinitions>
                        <!-- 0: Link volver -->
                        <RowDefinition Height="Auto"/>
                        <!-- 1: Título -->
                        <RowDefinition Height="Auto"/>
                        <!-- 2: Subtítulo -->
                        <RowDefinition Height="Auto"/>
                        <!-- 3: Formulario en tarjeta -->
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <!-- Enlace Menú Principal -->
                    <Button Grid.Row="0"
                            Style="{StaticResource LinkButtonStyle}"
                            Click="BtnVolverMenu_Click"
                            HorizontalAlignment="Left"
                            Margin="0,0,0,16">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <Path Data="M19 12H5 M12 19l-7-7 7-7"
                                  Stroke="#4B5563"
                                  StrokeThickness="1.8"
                                  StrokeStartLineCap="Round"
                                  StrokeEndLineCap="Round"
                                  Stretch="Uniform"
                                  Width="12" Height="12"
                                  VerticalAlignment="Center"
                                  Margin="0,0,8,0"/>
                            <TextBlock Text="Menú principal"
                                       FontSize="13.5"
                                       Foreground="#4B5563"
                                       FontWeight="Medium"
                                       VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>

                    <!-- Título -->
                    <TextBlock Grid.Row="1"
                               Text="Agregar Libro"
                               FontSize="32"
                               FontWeight="Bold"
                               Foreground="#111827"
                               Margin="0,0,0,6"/>

                    <!-- Subtítulo -->
                    <TextBlock Grid.Row="2"
                               Text="Ingresa los datos del nuevo libro para incorporarlo al catálogo e iniciar el control de inventario."
                               FontSize="14.5"
                               Foreground="#6B7280"
                               Margin="0,0,0,26"/>

                    <!-- Formulario en Tarjeta -->
                    <Border Grid.Row="3"
                            Background="#FFFFFF"
                            BorderBrush="#E5E7EB"
                            BorderThickness="1"
                            CornerRadius="12"
                            Padding="32,28,32,28">
                        <Border.Effect>
                            <DropShadowEffect Color="#101828"
                                              BlurRadius="12"
                                              ShadowDepth="1"
                                              Direction="270"
                                              Opacity="0.04"/>
                        </Border.Effect>
                        <StackPanel MaxWidth="680" HorizontalAlignment="Left">
                            <!-- Sección Cabecera interna -->
                            <TextBlock Text="Datos de la Obra"
                                       FontSize="16"
                                       FontWeight="Bold"
                                       Foreground="#111827"
                                       Margin="0,0,0,18"/>

                            <!-- Campo 1: ISBN -->
                            <TextBlock Text="ISBN (13 dígitos) *"
                                       FontSize="13.5"
                                       FontWeight="SemiBold"
                                       Foreground="#374151"
                                       Margin="0,0,0,6"/>
                            <TextBox x:Name="txtNuevoIsbn"
                                     Style="{StaticResource FormFieldTextBoxStyle}"
                                     MaxLength="17"
                                     PreviewTextInput="TxtSoloNumeros_PreviewTextInput"
                                     Margin="0,0,0,4"/>
                            <TextBlock Text="Ingresa los 13 dígitos numéricos sin guiones ni espacios (ej: 9788437604947)."
                                       FontSize="11.5"
                                       Foreground="#9CA3AF"
                                       Margin="0,0,0,18"/>

                            <!-- Campo 2: Título -->
                            <TextBlock Text="Título del libro *"
                                       FontSize="13.5"
                                       FontWeight="SemiBold"
                                       Foreground="#374151"
                                       Margin="0,0,0,6"/>
                            <TextBox x:Name="txtNuevoTitulo"
                                     Style="{StaticResource FormFieldTextBoxStyle}"
                                     MaxLength="150"
                                     Margin="0,0,0,18"/>

                            <!-- Fila de 2 Columnas: Autor y Editorial -->
                            <Grid Margin="0,0,0,18">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="20"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>

                                <!-- Campo 3: Autor -->
                                <StackPanel Grid.Column="0">
                                    <TextBlock Text="Autor *"
                                               FontSize="13.5"
                                               FontWeight="SemiBold"
                                               Foreground="#374151"
                                               Margin="0,0,0,6"/>
                                    <TextBox x:Name="txtNuevoAutor"
                                             Style="{StaticResource FormFieldTextBoxStyle}"
                                             MaxLength="100"/>
                                </StackPanel>

                                <!-- Campo 4: Editorial -->
                                <StackPanel Grid.Column="2">
                                    <TextBlock Text="Editorial"
                                               FontSize="13.5"
                                               FontWeight="SemiBold"
                                               Foreground="#374151"
                                               Margin="0,0,0,6"/>
                                    <TextBox x:Name="txtNuevaEditorial"
                                             Style="{StaticResource FormFieldTextBoxStyle}"
                                             MaxLength="100"/>
                                </StackPanel>
                            </Grid>

                            <!-- Divisor sutil -->
                            <Border Height="1" Background="#F3F4F6" Margin="0,4,0,20"/>

                            <TextBlock Text="Inventario Inicial"
                                       FontSize="16"
                                       FontWeight="Bold"
                                       Foreground="#111827"
                                       Margin="0,0,0,18"/>

                            <!-- Fila de 2 Columnas: Stock Total y Stock Disponible -->
                            <Grid Margin="0,0,0,28">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="20"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>

                                <!-- Campo 5: Stock Total -->
                                <StackPanel Grid.Column="0">
                                    <TextBlock Text="Stock Total (Ejemplares) *"
                                               FontSize="13.5"
                                               FontWeight="SemiBold"
                                               Foreground="#374151"
                                               Margin="0,0,0,6"/>
                                    <TextBox x:Name="txtNuevoStockTotal"
                                             Style="{StaticResource FormFieldTextBoxStyle}"
                                             MaxLength="5"
                                             PreviewTextInput="TxtSoloNumeros_PreviewTextInput"
                                             Text="1"/>
                                    <TextBlock Text="Cantidad física total de ejemplares que posee la biblioteca."
                                               FontSize="11.5"
                                               Foreground="#9CA3AF"
                                               Margin="0,4,0,0"/>
                                </StackPanel>

                                <!-- Campo 6: Stock Disponible Inicial (Automático) -->
                                <StackPanel Grid.Column="2">
                                    <TextBlock Text="Stock Disponible Inicial"
                                               FontSize="13.5"
                                               FontWeight="SemiBold"
                                               Foreground="#374151"
                                               Margin="0,0,0,6"/>
                                    <TextBox x:Name="txtNuevoStockDisponible"
                                             Style="{StaticResource FormFieldTextBoxStyle}"
                                             Text="{Binding ElementName=txtNuevoStockTotal, Path=Text}"
                                             IsReadOnly="True"
                                             Focusable="False"
                                             Background="#F3F4F6"
                                             Foreground="#6B7280"/>
                                    <TextBlock Text="Automático: todo libro nuevo ingresa con stock disponible igual al total."
                                               FontSize="11.5"
                                               Foreground="#9CA3AF"
                                               Margin="0,4,0,0"/>
                                </StackPanel>
                            </Grid>

                            <!-- Botones de Acción -->
                            <StackPanel Orientation="Horizontal">
                                <Button x:Name="btnGuardarNuevoLibro"
                                        Content="Guardar Libro"
                                        Style="{StaticResource PrimaryGreenButtonStyle}"
                                        Width="150" Height="42"
                                        FontSize="13.5"
                                        FontWeight="SemiBold"
                                        Margin="0,0,12,0"
                                        Click="BtnGuardarNuevoLibro_Click"/>
                                <Button x:Name="btnLimpiarNuevoLibro"
                                        Content="Limpiar"
                                        Style="{StaticResource OutlinedActionButtonStyle}"
                                        Width="100" Height="42"
                                        FontSize="13.5"
                                        Click="BtnLimpiarNuevoLibro_Click"/>
                            </StackPanel>
                        </StackPanel>
                    </Border>
                </Grid>

                <!-- ================= VISTA 2: MODIFICAR LIBRO ================= -->
                <Grid x:Name="gridModificarLibro" Visibility="Collapsed">
                    <Grid.RowDefinitions>
                        <!-- 0: Link volver -->
                        <RowDefinition Height="Auto"/>
                        <!-- 1: Título -->
                        <RowDefinition Height="Auto"/>
                        <!-- 2: Subtítulo -->
                        <RowDefinition Height="Auto"/>
                        <!-- 3: Barra de búsqueda -->
                        <RowDefinition Height="Auto"/>
                        <!-- 4: Tabla de libros para seleccionar -->
                        <RowDefinition Height="Auto"/>
                        <!-- 5: Formulario de edición del libro seleccionado -->
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <!-- Enlace Menú Principal -->
                    <Button Grid.Row="0"
                            Style="{StaticResource LinkButtonStyle}"
                            Click="BtnVolverMenu_Click"
                            HorizontalAlignment="Left"
                            Margin="0,0,0,16">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <Path Data="M19 12H5 M12 19l-7-7 7-7"
                                  Stroke="#4B5563"
                                  StrokeThickness="1.8"
                                  StrokeStartLineCap="Round"
                                  StrokeEndLineCap="Round"
                                  Stretch="Uniform"
                                  Width="12" Height="12"
                                  VerticalAlignment="Center"
                                  Margin="0,0,8,0"/>
                            <TextBlock Text="Menú principal"
                                       FontSize="13.5"
                                       Foreground="#4B5563"
                                       FontWeight="Medium"
                                       VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>

                    <!-- Título -->
                    <TextBlock Grid.Row="1"
                               Text="Modificar Libro"
                               FontSize="32"
                               FontWeight="Bold"
                               Foreground="#111827"
                               Margin="0,0,0,6"/>

                    <!-- Subtítulo -->
                    <TextBlock Grid.Row="2"
                               Text="Busca y selecciona un libro del catálogo para actualizar sus detalles o ajustar los niveles de stock."
                               FontSize="14.5"
                               Foreground="#6B7280"
                               Margin="0,0,0,26"/>

                    <!-- Barra de Búsqueda -->
                    <Border Grid.Row="3"
                            Height="42"
                            Background="#FFFFFF"
                            BorderBrush="#D1D5DB"
                            BorderThickness="1"
                            CornerRadius="8"
                            Padding="14,0,14,0"
                            Margin="0,0,0,20">
                        <Grid VerticalAlignment="Center">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <Path Grid.Column="0"
                                  Data="M21 21l-4.35-4.35M17 11a6 6 0 1 1-12 0 6 6 0 0 1 12 0z"
                                  Stroke="#9CA3AF"
                                  StrokeThickness="1.8"
                                  StrokeStartLineCap="Round"
                                  StrokeEndLineCap="Round"
                                  Stretch="Uniform"
                                  Width="14" Height="14"
                                  Margin="0,0,10,0"
                                  VerticalAlignment="Center"/>

                            <TextBlock Grid.Column="1"
                                       x:Name="txtPlaceholderBuscarModificar"
                                       Text="Buscar libro por título, autor o ISBN..."
                                       FontSize="13.5"
                                       Foreground="#9CA3AF"
                                       VerticalAlignment="Center"
                                       IsHitTestVisible="False"/>

                            <TextBox Grid.Column="1"
                                     x:Name="txtBuscarModificar"
                                     BorderThickness="0"
                                     Background="Transparent"
                                     FontSize="13.5"
                                     Foreground="#111827"
                                     VerticalAlignment="Center"
                                     TextChanged="TxtBuscarModificar_TextChanged"/>
                        </Grid>
                    </Border>

                    <!-- Tabla de Libros Registrados -->
                    <Border Grid.Row="4"
                            Background="#FFFFFF"
                            BorderBrush="#E5E7EB"
                            BorderThickness="1"
                            CornerRadius="12"
                            Margin="0,0,0,24">
                        <Border.Effect>
                            <DropShadowEffect Color="#101828"
                                              BlurRadius="12"
                                              ShadowDepth="1"
                                              Direction="270"
                                              Opacity="0.04"/>
                        </Border.Effect>
                        <StackPanel>
                            <!-- Cabecera de la Tarjeta -->
                            <DockPanel Margin="24,18,24,14" LastChildFill="False">
                                <TextBlock DockPanel.Dock="Left"
                                           Text="Selecciona el libro a editar"
                                           FontSize="16"
                                           FontWeight="Bold"
                                           Foreground="#111827"
                                           VerticalAlignment="Center"/>
                                <TextBlock DockPanel.Dock="Right"
                                           x:Name="lblContadorLibrosModificar"
                                           Text="0 libros en catálogo"
                                           FontSize="13.5"
                                           Foreground="#6B7280"
                                           VerticalAlignment="Center"/>
                            </DockPanel>

                            <!-- Cabecera de la Tabla -->
                            <Border Background="#EFF5F1" Padding="24,12,24,12">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="1.4*"/>
                                        <ColumnDefinition Width="2.2*"/>
                                        <ColumnDefinition Width="1.8*"/>
                                        <ColumnDefinition Width="110"/>
                                        <ColumnDefinition Width="100"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="ISBN" FontSize="12.5" FontWeight="SemiBold" Foreground="#4B5563"/>
                                    <TextBlock Grid.Column="1" Text="Título" FontSize="12.5" FontWeight="SemiBold" Foreground="#4B5563"/>
                                    <TextBlock Grid.Column="2" Text="Autor" FontSize="12.5" FontWeight="SemiBold" Foreground="#4B5563"/>
                                    <TextBlock Grid.Column="3" Text="Disponibles" FontSize="12.5" FontWeight="SemiBold" Foreground="#4B5563" HorizontalAlignment="Center"/>
                                    <TextBlock Grid.Column="4" Text="Acción" FontSize="12.5" FontWeight="SemiBold" Foreground="#4B5563" HorizontalAlignment="Center"/>
                                </Grid>
                            </Border>

                            <!-- Filas dinámicas enlazadas -->
                            <ItemsControl x:Name="icListaLibrosModificar">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border BorderBrush="#F3F4F6" BorderThickness="0,0,0,1" Padding="24,12,24,12">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="1.4*"/>
                                                    <ColumnDefinition Width="2.2*"/>
                                                    <ColumnDefinition Width="1.8*"/>
                                                    <ColumnDefinition Width="110"/>
                                                    <ColumnDefinition Width="100"/>
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Grid.Column="0" Text="{Binding IsbnFormateado}" FontSize="13" Foreground="#4B5563" VerticalAlignment="Center"/>
                                                <TextBlock Grid.Column="1" Text="{Binding Titulo}" FontSize="13.5" FontWeight="SemiBold" Foreground="#111827" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                                                <TextBlock Grid.Column="2" Text="{Binding Autor}" FontSize="13" Foreground="#4B5563" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                                                <Border Grid.Column="3" Background="{Binding ColorBadgeStock}" CornerRadius="12" Padding="10,3,10,3" HorizontalAlignment="Center" VerticalAlignment="Center">
                                                    <TextBlock Text="{Binding StockRatioTexto}" FontSize="12" FontWeight="SemiBold" Foreground="{Binding ColorStock}"/>
                                                </Border>
                                                <Button Grid.Column="4"
                                                        Content="Seleccionar"
                                                        Style="{StaticResource OutlinedActionButtonStyle}"
                                                        Width="85"
                                                        HorizontalAlignment="Center"
                                                        Tag="{Binding}"
                                                        Click="BtnSeleccionarLibroModificar_Click"/>
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>

                            <!-- Panel Sin Resultados -->
                            <StackPanel x:Name="panelSinResultadosModificar"
                                        Visibility="Collapsed"
                                        HorizontalAlignment="Center"
                                        Margin="0,32,0,32">
                                <Path Data="M21 21l-4.35-4.35M17 11a6 6 0 1 1-12 0 6 6 0 0 1 12 0z"
                                      Stroke="#9CA3AF"
                                      StrokeThickness="1.5"
                                      Width="28" Height="28"
                                      HorizontalAlignment="Center"
                                      Margin="0,0,0,12"/>
                                <TextBlock Text="No se encontraron libros en el catálogo con ese criterio."
                                           FontSize="14"
                                           Foreground="#6B7280"
                                           HorizontalAlignment="Center"/>
                            </StackPanel>
                        </StackPanel>
                    </Border>

                    <!-- Formulario de Edición del Libro Seleccionado -->
                    <Border Grid.Row="5"
                            x:Name="borderFormularioModificar"
                            Background="#FFFFFF"
                            BorderBrush="#E5E7EB"
                            BorderThickness="1"
                            CornerRadius="12"
                            Padding="32,28,32,28">
                        <Border.Effect>
                            <DropShadowEffect Color="#101828"
                                              BlurRadius="12"
                                              ShadowDepth="1"
                                              Direction="270"
                                              Opacity="0.04"/>
                        </Border.Effect>
                        <StackPanel MaxWidth="680" HorizontalAlignment="Left">
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                                <TextBlock Text="Editar Datos del Libro"
                                           FontSize="16"
                                           FontWeight="Bold"
                                           Foreground="#111827"/>
                                <TextBlock x:Name="lblEstadoSeleccionModificar"
                                           Text="(Ningún libro seleccionado)"
                                           FontSize="13"
                                           FontStyle="Italic"
                                           Foreground="#6B7280"
                                           Margin="10,2,0,0"
                                           VerticalAlignment="Center"/>
                            </StackPanel>
                            <TextBlock x:Name="lblAyudaFormularioModificar"
                                       Text="Selecciona un libro de la lista superior para cargar y modificar sus datos."
                                       FontSize="12.5"
                                       Foreground="#6B7280"
                                       Margin="0,0,0,18"/>

                            <!-- ISBN -->
                            <TextBlock Text="ISBN"
                                       FontSize="13.5"
                                       FontWeight="SemiBold"
                                       Foreground="#374151"
                                       Margin="0,0,0,6"/>
                            <TextBox x:Name="txtModificarIsbn"
                                     Style="{StaticResource FormFieldTextBoxStyle}"
                                     MaxLength="17"
                                     PreviewTextInput="TxtSoloNumeros_PreviewTextInput"
                                     Margin="0,0,0,18"/>

                            <!-- Título -->
                            <TextBlock Text="Título del libro *"
                                       FontSize="13.5"
                                       FontWeight="SemiBold"
                                       Foreground="#374151"
                                       Margin="0,0,0,6"/>
                            <TextBox x:Name="txtModificarTitulo"
                                     Style="{StaticResource FormFieldTextBoxStyle}"
                                     MaxLength="150"
                                     Margin="0,0,0,18"/>

                            <!-- Fila de Autor y Editorial -->
                            <Grid Margin="0,0,0,18">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="20"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>

                                <StackPanel Grid.Column="0">
                                    <TextBlock Text="Autor *"
                                               FontSize="13.5"
                                               FontWeight="SemiBold"
                                               Foreground="#374151"
                                               Margin="0,0,0,6"/>
                                    <TextBox x:Name="txtModificarAutor"
                                             Style="{StaticResource FormFieldTextBoxStyle}"
                                             MaxLength="100"/>
                                </StackPanel>

                                <StackPanel Grid.Column="2">
                                    <TextBlock Text="Editorial"
                                               FontSize="13.5"
                                               FontWeight="SemiBold"
                                               Foreground="#374151"
                                               Margin="0,0,0,6"/>
                                    <TextBox x:Name="txtModificarEditorial"
                                             Style="{StaticResource FormFieldTextBoxStyle}"
                                             MaxLength="100"/>
                                </StackPanel>
                            </Grid>

                            <!-- Divisor sutil -->
                            <Border Height="1" Background="#F3F4F6" Margin="0,4,0,20"/>

                            <TextBlock Text="Actualizar Stock"
                                       FontSize="16"
                                       FontWeight="Bold"
                                       Foreground="#111827"
                                       Margin="0,0,0,18"/>

                            <!-- Fila de Stock Total y Stock Disponible -->
                            <Grid Margin="0,0,0,28">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="20"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>

                                <StackPanel Grid.Column="0">
                                    <TextBlock Text="Stock Total *"
                                               FontSize="13.5"
                                               FontWeight="SemiBold"
                                               Foreground="#374151"
                                               Margin="0,0,0,6"/>
                                    <TextBox x:Name="txtModificarStockTotal"
                                             Style="{StaticResource FormFieldTextBoxStyle}"
                                             MaxLength="5"
                                             PreviewTextInput="TxtSoloNumeros_PreviewTextInput"/>
                                </StackPanel>

                                <StackPanel Grid.Column="2">
                                    <TextBlock Text="Stock Disponible (Protegido)"
                                               FontSize="13.5"
                                               FontWeight="SemiBold"
                                               Foreground="#374151"
                                               Margin="0,0,0,6"/>
                                    <TextBox x:Name="txtModificarStockDisponible"
                                             Style="{StaticResource FormFieldTextBoxStyle}"
                                             IsReadOnly="True"
                                             Focusable="False"
                                             Background="#F3F4F6"
                                             Foreground="#6B7280"/>
                                    <TextBlock Text="Calculado automáticamente (Stock Total menos préstamos activos)."
                                               FontSize="11.5"
                                               Foreground="#9CA3AF"
                                               Margin="0,4,0,0"/>
                                </StackPanel>
                            </Grid>

                            <!-- Botones de Acción -->
                            <StackPanel Orientation="Horizontal">
                                <Button x:Name="btnGuardarModificar"
                                        Content="Guardar Cambios"
                                        Style="{StaticResource PrimaryGreenButtonStyle}"
                                        Width="160" Height="42"
                                        FontSize="13.5"
                                        FontWeight="SemiBold"
                                        Margin="0,0,12,0"
                                        Click="BtnGuardarModificar_Click"/>
                                <Button x:Name="btnCancelarModificar"
                                        Content="Cancelar"
                                        Style="{StaticResource OutlinedActionButtonStyle}"
                                        Width="100" Height="42"
                                        FontSize="13.5"
                                        Click="BtnCancelarModificar_Click"/>
                            </StackPanel>
                        </StackPanel>
                    </Border>
                </Grid>

                <!-- ================= VISTA 3: ELIMINAR LIBRO ================= -->
                <Grid x:Name="gridEliminarLibro" Visibility="Collapsed">
                    <Grid.RowDefinitions>
                        <!-- 0: Link volver -->
                        <RowDefinition Height="Auto"/>
                        <!-- 1: Título -->
                        <RowDefinition Height="Auto"/>
                        <!-- 2: Subtítulo -->
                        <RowDefinition Height="Auto"/>
                        <!-- 3: Alerta informativa -->
                        <RowDefinition Height="Auto"/>
                        <!-- 4: Barra de búsqueda -->
                        <RowDefinition Height="Auto"/>
                        <!-- 5: Tabla de eliminación -->
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <!-- Enlace Menú Principal -->
                    <Button Grid.Row="0"
                            Style="{StaticResource LinkButtonStyle}"
                            Click="BtnVolverMenu_Click"
                            HorizontalAlignment="Left"
                            Margin="0,0,0,16">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <Path Data="M19 12H5 M12 19l-7-7 7-7"
                                  Stroke="#4B5563"
                                  StrokeThickness="1.8"
                                  StrokeStartLineCap="Round"
                                  StrokeEndLineCap="Round"
                                  Stretch="Uniform"
                                  Width="12" Height="12"
                                  VerticalAlignment="Center"
                                  Margin="0,0,8,0"/>
                            <TextBlock Text="Menú principal"
                                       FontSize="13.5"
                                       Foreground="#4B5563"
                                       FontWeight="Medium"
                                       VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>

                    <!-- Título -->
                    <TextBlock Grid.Row="1"
                               Text="Eliminar Libro"
                               FontSize="32"
                               FontWeight="Bold"
                               Foreground="#111827"
                               Margin="0,0,0,6"/>

                    <!-- Subtítulo -->
                    <TextBlock Grid.Row="2"
                               Text="Gestiona la remoción definitiva de libros del catálogo o la baja de títulos descontinuados."
                               FontSize="14.5"
                               Foreground="#6B7280"
                               Margin="0,0,0,20"/>

                    <!-- Alerta / Advertencia institucional -->
                    <Border Grid.Row="3"
                            Background="#FFFBEB"
                            BorderBrush="#FDE68A"
                            BorderThickness="1"
                            CornerRadius="8"
                            Padding="16,12,16,12"
                            Margin="0,0,0,22">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <!-- Icono de advertencia / alerta -->
                            <Path Grid.Column="0"
                                  Data="M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-3L13.732 4c-.77-1.333-2.694-1.333-3.464 0L3.34 16c-.77 1.333.192 3 1.732 3z"
                                  Stroke="#D97706"
                                  StrokeThickness="1.8"
                                  StrokeStartLineCap="Round"
                                  StrokeEndLineCap="Round"
                                  StrokeLineJoin="Round"
                                  Stretch="Uniform"
                                  Width="18" Height="18"
                                  Margin="0,0,12,0"
                                  VerticalAlignment="Center"/>

                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                <TextBlock Text="Información importante sobre la baja de libros"
                                           FontSize="13"
                                           FontWeight="SemiBold"
                                           Foreground="#92400E"/>
                                <TextBlock Text="Los libros que cuenten con préstamos activos asociados no podrán ser eliminados hasta que se registre la devolución de todos los ejemplares prestados."
                                           FontSize="12.5"
                                           Foreground="#B45309"
                                           Margin="0,2,0,0"/>
                            </StackPanel>
                        </Grid>
                    </Border>

                    <!-- Barra de Búsqueda -->
                    <Border Grid.Row="4"
                            Height="42"
                            Background="#FFFFFF"
                            BorderBrush="#D1D5DB"
                            BorderThickness="1"
                            CornerRadius="8"
                            Padding="14,0,14,0"
                            Margin="0,0,0,24">
                        <Grid VerticalAlignment="Center">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <Path Grid.Column="0"
                                  Data="M21 21l-4.35-4.35M17 11a6 6 0 1 1-12 0 6 6 0 0 1 12 0z"
                                  Stroke="#9CA3AF"
                                  StrokeThickness="1.8"
                                  StrokeStartLineCap="Round"
                                  StrokeEndLineCap="Round"
                                  Stretch="Uniform"
                                  Width="14" Height="14"
                                  Margin="0,0,10,0"
                                  VerticalAlignment="Center"/>

                            <TextBlock Grid.Column="1"
                                       x:Name="txtPlaceholderBuscarEliminar"
                                       Text="Buscar libro a eliminar por título, autor o ISBN..."
                                       FontSize="13.5"
                                       Foreground="#9CA3AF"
                                       VerticalAlignment="Center"
                                       IsHitTestVisible="False"/>

                            <TextBox Grid.Column="1"
                                     x:Name="txtBuscarEliminar"
                                     BorderThickness="0"
                                     Background="Transparent"
                                     FontSize="13.5"
                                     Foreground="#111827"
                                     VerticalAlignment="Center"
                                     TextChanged="TxtBuscarEliminar_TextChanged"/>
                        </Grid>
                    </Border>

                    <!-- Tarjeta con Tabla de Libros para Eliminar -->
                    <Border Grid.Row="5"
                            Background="#FFFFFF"
                            BorderBrush="#E5E7EB"
                            BorderThickness="1"
                            CornerRadius="12">
                        <Border.Effect>
                            <DropShadowEffect Color="#101828"
                                              BlurRadius="12"
                                              ShadowDepth="1"
                                              Direction="270"
                                              Opacity="0.04"/>
                        </Border.Effect>
                        <StackPanel>
                            <!-- Cabecera de la Tarjeta -->
                            <DockPanel Margin="24,18,24,14" LastChildFill="False">
                                <TextBlock DockPanel.Dock="Left"
                                           Text="Catálogo de libros disponibles"
                                           FontSize="16"
                                           FontWeight="Bold"
                                           Foreground="#111827"
                                           VerticalAlignment="Center"/>
                                <TextBlock DockPanel.Dock="Right"
                                           x:Name="lblContadorLibrosEliminar"
                                           Text="0 libros en catálogo"
                                           FontSize="13.5"
                                           Foreground="#6B7280"
                                           VerticalAlignment="Center"/>
                            </DockPanel>

                            <!-- Cabecera de la Tabla -->
                            <Border Background="#EFF5F1" Padding="24,12,24,12">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="1.4*"/>
                                        <ColumnDefinition Width="2.2*"/>
                                        <ColumnDefinition Width="1.8*"/>
                                        <ColumnDefinition Width="110"/>
                                        <ColumnDefinition Width="100"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="ISBN" FontSize="12.5" FontWeight="SemiBold" Foreground="#4B5563"/>
                                    <TextBlock Grid.Column="1" Text="Título" FontSize="12.5" FontWeight="SemiBold" Foreground="#4B5563"/>
                                    <TextBlock Grid.Column="2" Text="Autor" FontSize="12.5" FontWeight="SemiBold" Foreground="#4B5563"/>
                                    <TextBlock Grid.Column="3" Text="Stock Total" FontSize="12.5" FontWeight="SemiBold" Foreground="#4B5563" HorizontalAlignment="Center"/>
                                    <TextBlock Grid.Column="4" Text="Acción" FontSize="12.5" FontWeight="SemiBold" Foreground="#4B5563" HorizontalAlignment="Center"/>
                                </Grid>
                            </Border>

                            <!-- Filas dinámicas enlazadas -->
                            <ItemsControl x:Name="icListaLibrosEliminar">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border BorderBrush="#F3F4F6" BorderThickness="0,0,0,1" Padding="24,14,24,14">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="1.4*"/>
                                                    <ColumnDefinition Width="2.2*"/>
                                                    <ColumnDefinition Width="1.8*"/>
                                                    <ColumnDefinition Width="110"/>
                                                    <ColumnDefinition Width="100"/>
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Grid.Column="0" Text="{Binding IsbnFormateado}" FontSize="13" Foreground="#4B5563" VerticalAlignment="Center"/>
                                                <TextBlock Grid.Column="1" Text="{Binding Titulo}" FontSize="13.5" FontWeight="SemiBold" Foreground="#111827" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                                                <TextBlock Grid.Column="2" Text="{Binding Autor}" FontSize="13" Foreground="#4B5563" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                                                <TextBlock Grid.Column="3" Text="{Binding StockTotalTexto}" FontSize="13" Foreground="#374151" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                <Button Grid.Column="4"
                                                        Content="Eliminar"
                                                        Style="{StaticResource DangerActionButtonStyle}"
                                                        Width="85"
                                                        HorizontalAlignment="Center"
                                                        Tag="{Binding}"
                                                        Click="BtnEliminarLibro_Click"/>
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>

                            <!-- Panel Sin Resultados -->
                            <StackPanel x:Name="panelSinResultadosEliminar"
                                        Visibility="Collapsed"
                                        HorizontalAlignment="Center"
                                        Margin="0,32,0,32">
                                <Path Data="M21 21l-4.35-4.35M17 11a6 6 0 1 1-12 0 6 6 0 0 1 12 0z"
                                      Stroke="#9CA3AF"
                                      StrokeThickness="1.5"
                                      Width="28" Height="28"
                                      HorizontalAlignment="Center"
                                      Margin="0,0,0,12"/>
                                <TextBlock Text="No se encontraron libros para eliminar con ese criterio."
                                           FontSize="14"
                                           Foreground="#6B7280"
                                           HorizontalAlignment="Center"/>
                            </StackPanel>
                        </StackPanel>
                    </Border>
                </Grid>

            </Grid>
        </ScrollViewer>
    </Grid>
</Window>
