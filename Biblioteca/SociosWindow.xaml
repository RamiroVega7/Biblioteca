<Window x:Class="SociosWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="Biblioteca - Administrar Socios"
        Height="730" Width="1120"
        MinHeight="640" MinWidth="920"
        WindowStartupLocation="CenterScreen"
        Background="#F7F6F2"
        FontFamily="Segoe UI">

    <Window.Resources>
        <!-- Estilo para botones tipo enlace / transparentes -->
        <Style x:Key="LinkButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="BorderElem" Background="{TemplateBinding Background}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="BorderElem" Property="Opacity" Value="0.4"/>
                                <Setter Property="Cursor" Value="Arrow"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Estilo para botones del menú lateral -->
        <Style x:Key="SidebarButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="14,10,14,10"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="HorizontalContentAlignment" Value="Left"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="BorderElem"
                                Background="{TemplateBinding Background}"
                                CornerRadius="8"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="BorderElem" Property="Background" Value="#EDECE7"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Estilo para botón primario verde -->
        <Style x:Key="PrimaryGreenButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="#1D3B31"/>
            <Setter Property="Foreground" Value="#FFFFFF"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="BtnBorder"
                                Background="{TemplateBinding Background}"
                                CornerRadius="8"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="BtnBorder" Property="Background" Value="#254A3E"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="BtnBorder" Property="Background" Value="#142821"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="BtnBorder" Property="Opacity" Value="0.6"/>
                                <Setter Property="Cursor" Value="Arrow"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Estilo para botón secundario contorneado (blanco con borde gris) -->
        <Style x:Key="OutlinedActionButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="#FFFFFF"/>
            <Setter Property="Foreground" Value="#374151"/>
            <Setter Property="BorderBrush" Value="#D1D5DB"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Height" Value="32"/>
            <Setter Property="Width" Value="96"/>
            <Setter Property="FontSize" Value="12.5"/>
            <Setter Property="FontWeight" Value="Medium"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="BtnBorder"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="6">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="BtnBorder" Property="Background" Value="#F9FAFB"/>
                                <Setter TargetName="BtnBorder" Property="BorderBrush" Value="#9CA3AF"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="BtnBorder" Property="Background" Value="#F3F4F6"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="BtnBorder" Property="Opacity" Value="0.5"/>
                                <Setter Property="Cursor" Value="Arrow"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Estilo para botón de acción verde sólido (Activar) -->
        <Style x:Key="SolidGreenActionButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="#1D3B31"/>
            <Setter Property="Foreground" Value="#FFFFFF"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Height" Value="32"/>
            <Setter Property="Width" Value="96"/>
            <Setter Property="FontSize" Value="12.5"/>
            <Setter Property="FontWeight" Value="Medium"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="BtnBorder"
                                Background="{TemplateBinding Background}"
                                CornerRadius="6">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="BtnBorder" Property="Background" Value="#254A3E"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="BtnBorder" Property="Background" Value="#142821"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="BtnBorder" Property="Opacity" Value="0.5"/>
                                <Setter Property="Cursor" Value="Arrow"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Estilo para campos de formulario -->
        <Style x:Key="FormFieldTextBoxStyle" TargetType="TextBox">
            <Setter Property="Height" Value="42"/>
            <Setter Property="Background" Value="#FFFFFF"/>
            <Setter Property="BorderBrush" Value="#D1D5DB"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="FontSize" Value="13.5"/>
            <Setter Property="Foreground" Value="#111827"/>
            <Setter Property="Padding" Value="12,0,12,0"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border x:Name="Border"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="8">
                            <ScrollViewer x:Name="PART_ContentHost" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Border" Property="BorderBrush" Value="#9CA3AF"/>
                            </Trigger>
                            <Trigger Property="IsFocused" Value="True">
                                <Setter TargetName="Border" Property="BorderBrush" Value="#1D3B31"/>
                                <Setter TargetName="Border" Property="BorderThickness" Value="1.5"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <!-- Barra Lateral Izquierda -->
            <ColumnDefinition Width="225"/>
            <!-- Área Principal de Contenido -->
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- ================= PANEL LATERAL ================= -->
        <Border Grid.Column="0"
                Background="#F7F6F2"
                BorderBrush="#E5E7EB"
                BorderThickness="0,0,1,0">
            <Grid Margin="20,22,20,22">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- Header de Marca (Logo y Título) -->
                <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="4,0,0,32">
                    <Border Width="38" Height="38"
                            Background="#1D3B31"
                            CornerRadius="8"
                            VerticalAlignment="Center">
                        <Path Data="M3 4.5A2.5 2.5 0 0 1 5.5 2H10a3 3 0 0 1 3 3v13.5a2.5 2.5 0 0 0-2.5-2H5.5A2.5 2.5 0 0 0 3 19V4.5z M21 4.5A2.5 2.5 0 0 0 18.5 2H14a3 3 0 0 0-3 3v13.5a2.5 2.5 0 0 1 2.5-2h5A2.5 2.5 0 0 1 21 19V4.5z"
                              Stroke="#FFFFFF"
                              StrokeThickness="1.6"
                              Fill="Transparent"
                              StrokeStartLineCap="Round"
                              StrokeEndLineCap="Round"
                              StrokeLineJoin="Round"
                              Stretch="Uniform"
                              Width="18" Height="18"
                              HorizontalAlignment="Center"
                              VerticalAlignment="Center"/>
                    </Border>
                    <StackPanel Margin="12,0,0,0" VerticalAlignment="Center">
                        <TextBlock Text="Biblioteca"
                                   FontSize="15"
                                   FontWeight="Bold"
                                   Foreground="#111827"/>
                        <TextBlock Text="Sistema de gestión"
                                   FontSize="11.5"
                                   Foreground="#6B7280"
                                   Margin="0,1,0,0"/>
                    </StackPanel>
                </StackPanel>

                <!-- Menú de Navegación Lateral -->
                <StackPanel Grid.Row="1" Margin="0,4,0,0">
                    <!-- Opción 1: Lista de socios (Activo por defecto) -->
                    <Button x:Name="btnNavListaSocios"
                            Style="{StaticResource SidebarButtonStyle}"
                            Background="#EBF3EF"
                            Margin="0,0,0,6"
                            Click="BtnListaSocios_Click">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <!-- Icono de lista -->
                            <Path x:Name="iconNavListaSocios"
                                  Data="M3 6h2 M9 6h12 M3 12h2 M9 12h12 M3 18h2 M9 18h12"
                                  Stroke="#1D3B31"
                                  StrokeThickness="1.8"
                                  StrokeStartLineCap="Round"
                                  StrokeEndLineCap="Round"
                                  Stretch="Uniform"
                                  Width="15" Height="15"
                                  Margin="0,0,10,0"
                                  VerticalAlignment="Center"/>
                            <TextBlock x:Name="textNavListaSocios"
                                       Text="Lista de socios"
                                       FontSize="13.5"
                                       FontWeight="SemiBold"
                                       Foreground="#1D3B31"
                                       VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>

                    <!-- Opción 2: Registrar socio -->
                    <Button x:Name="btnNavRegistrarSocio"
                            Style="{StaticResource SidebarButtonStyle}"
                            Background="Transparent"
                            Margin="0,0,0,6"
                            Click="BtnNavRegistrarSocio_Click">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <!-- Icono badge con cruz -->
                            <Path x:Name="iconNavRegistrarSocio"
                                  Data="M19 3H5a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2V5a2 2 0 0 0-2-2z M12 8v8 M8 12h8"
                                  Stroke="#4B5563"
                                  StrokeThickness="1.8"
                                  StrokeStartLineCap="Round"
                                  StrokeEndLineCap="Round"
                                  Stretch="Uniform"
                                  Width="15" Height="15"
                                  Margin="0,0,10,0"
                                  VerticalAlignment="Center"/>
                            <TextBlock x:Name="textNavRegistrarSocio"
                                       Text="Registrar socio"
                                       FontSize="13.5"
                                       Foreground="#4B5563"
                                       VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                </StackPanel>

                <!-- Pie de Menú Lateral -->
                <TextBlock Grid.Row="2"
                           Text="Biblioteca · Gestión bibliotecaria"
                           FontSize="11.5"
                           Foreground="#9CA3AF"
                           Margin="6,0,0,4"/>
            </Grid>
        </Border>

        <!-- ================= CONTENIDO PRINCIPAL ================= -->
        <ScrollViewer Grid.Column="1"
                      x:Name="scrollPrincipal"
                      VerticalScrollBarVisibility="Auto"
                      HorizontalScrollBarVisibility="Disabled">
            <Grid Margin="48,26,48,36"
                  MaxWidth="960"
                  HorizontalAlignment="Stretch">

                <!-- ================= VISTA 1: LISTA DE SOCIOS ================= -->
                <Grid x:Name="gridListaSocios" Visibility="Visible">
                    <Grid.RowDefinitions>
                        <!-- Link volver -->
                        <RowDefinition Height="Auto"/>
                        <!-- Título -->
                        <RowDefinition Height="Auto"/>
                        <!-- Subtítulo -->
                        <RowDefinition Height="Auto"/>
                        <!-- Barra de Búsqueda -->
                        <RowDefinition Height="Auto"/>
                        <!-- Tarjeta Tabla de Socios -->
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <!-- 1. Enlace Menú Principal -->
                    <Button Grid.Row="0"
                            Style="{StaticResource LinkButtonStyle}"
                            Click="BtnVolverMenu_Click"
                            HorizontalAlignment="Left"
                            Margin="0,0,0,16">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <Path Data="M19 12H5 M12 19l-7-7 7-7"
                                  Stroke="#4B5563"
                                  StrokeThickness="1.8"
                                  StrokeStartLineCap="Round"
                                  StrokeEndLineCap="Round"
                                  Stretch="Uniform"
                                  Width="12" Height="12"
                                  VerticalAlignment="Center"
                                  Margin="0,0,8,0"/>
                            <TextBlock Text="Menú principal"
                                       FontSize="13.5"
                                       Foreground="#4B5563"
                                       FontWeight="Medium"
                                       VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>

                    <!-- 2. Título -->
                    <TextBlock Grid.Row="1"
                               Text="Administrar Socios"
                               FontSize="32"
                               FontWeight="Bold"
                               Foreground="#111827"
                               Margin="0,0,0,6"/>

                    <!-- 3. Subtítulo -->
                    <TextBlock Grid.Row="2"
                               Text="Consulta los datos de los socios y administra su estado."
                               FontSize="14.5"
                               Foreground="#6B7280"
                               Margin="0,0,0,26"/>

                    <!-- 4. Barra de Búsqueda (ancho completo) -->
                    <Border Grid.Row="3"
                            Height="42"
                            Background="#FFFFFF"
                            BorderBrush="#D1D5DB"
                            BorderThickness="1"
                            CornerRadius="8"
                            Padding="14,0,14,0"
                            Margin="0,0,0,24">
                        <Grid VerticalAlignment="Center">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <!-- Icono lupa -->
                            <Path Grid.Column="0"
                                  Data="M21 21l-4.35-4.35M17 11a6 6 0 1 1-12 0 6 6 0 0 1 12 0z"
                                  Stroke="#9CA3AF"
                                  StrokeThickness="1.8"
                                  StrokeStartLineCap="Round"
                                  StrokeEndLineCap="Round"
                                  Stretch="Uniform"
                                  Width="14" Height="14"
                                  Margin="0,0,10,0"
                                  VerticalAlignment="Center"/>

                            <!-- Placeholder -->
                            <TextBlock Grid.Column="1"
                                       x:Name="txtPlaceholderBuscarSocios"
                                       Text="Buscar por nombre, DNI o email"
                                       FontSize="13.5"
                                       Foreground="#9CA3AF"
                                       VerticalAlignment="Center"
                                       IsHitTestVisible="False"/>

                            <!-- Input -->
                            <TextBox Grid.Column="1"
                                     x:Name="txtBuscarSocios"
                                     BorderThickness="0"
                                     Background="Transparent"
                                     FontSize="13.5"
                                     Foreground="#111827"
                                     VerticalAlignment="Center"
                                     TextChanged="TxtBuscarSocios_TextChanged"/>
                        </Grid>
                    </Border>

                    <!-- 5. Tarjeta de Tabla: Lista de socios -->
                    <Border Grid.Row="4"
                            Background="#FFFFFF"
                            BorderBrush="#E5E7EB"
                            BorderThickness="1"
                            CornerRadius="12">
                        <Border.Effect>
                            <DropShadowEffect Color="#101828"
                                              BlurRadius="12"
                                              ShadowDepth="1"
                                              Direction="270"
                                              Opacity="0.04"/>
                        </Border.Effect>
                        <StackPanel>
                            <!-- Cabecera de la Tarjeta -->
                            <DockPanel Margin="24,20,24,18" LastChildFill="False">
                                <TextBlock DockPanel.Dock="Left"
                                           Text="Lista de socios"
                                           FontSize="18"
                                           FontWeight="Bold"
                                           Foreground="#111827"
                                           VerticalAlignment="Center"/>
                                <TextBlock DockPanel.Dock="Right"
                                           x:Name="lblContadorSocios"
                                           Text="7 socios registrados"
                                           FontSize="13.5"
                                           Foreground="#6B7280"
                                           VerticalAlignment="Center"/>
                            </DockPanel>

                            <!-- Cabecera de la Tabla -->
                            <Border Background="#EFF5F1" Padding="24,12,24,12">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="2.2*"/>
                                        <ColumnDefinition Width="1.3*"/>
                                        <ColumnDefinition Width="2.5*"/>
                                        <ColumnDefinition Width="130"/>
                                        <ColumnDefinition Width="110"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0"
                                               Text="Nombre"
                                               FontSize="12.5"
                                               FontWeight="SemiBold"
                                               Foreground="#4B5563"/>
                                    <TextBlock Grid.Column="1"
                                               Text="DNI"
                                               FontSize="12.5"
                                               FontWeight="SemiBold"
                                               Foreground="#4B5563"/>
                                    <TextBlock Grid.Column="2"
                                               Text="Email"
                                               FontSize="12.5"
                                               FontWeight="SemiBold"
                                               Foreground="#4B5563"/>
                                    <TextBlock Grid.Column="3"
                                               Text="Estado"
                                               FontSize="12.5"
                                               FontWeight="SemiBold"
                                               Foreground="#4B5563"
                                               HorizontalAlignment="Center"/>
                                    <TextBlock Grid.Column="4"
                                               Text="Acción"
                                               FontSize="12.5"
                                               FontWeight="SemiBold"
                                               Foreground="#4B5563"
                                               HorizontalAlignment="Center"/>
                                </Grid>
                            </Border>

                            <!-- Items de la Tabla -->
                            <ItemsControl x:Name="icSocios">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border BorderBrush="#F3F4F6"
                                                BorderThickness="0,0,0,1"
                                                Padding="24,14,24,14">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="2.2*"/>
                                                    <ColumnDefinition Width="1.3*"/>
                                                    <ColumnDefinition Width="2.5*"/>
                                                    <ColumnDefinition Width="130"/>
                                                    <ColumnDefinition Width="110"/>
                                                </Grid.ColumnDefinitions>

                                                <!-- Nombre Completo -->
                                                <TextBlock Grid.Column="0"
                                                           Text="{Binding NombreCompleto}"
                                                           FontSize="13.5"
                                                           FontWeight="SemiBold"
                                                           Foreground="#111827"
                                                           VerticalAlignment="Center"/>

                                                <!-- DNI Formateado con miles -->
                                                <TextBlock Grid.Column="1"
                                                           Text="{Binding DniFormateado}"
                                                           FontSize="13.5"
                                                           Foreground="#4B5563"
                                                           VerticalAlignment="Center"/>

                                                <!-- Email -->
                                                <TextBlock Grid.Column="2"
                                                           Text="{Binding Email}"
                                                           FontSize="13.5"
                                                           Foreground="#4B5563"
                                                           VerticalAlignment="Center"/>

                                                <!-- Estado Badge -->
                                                <Border Grid.Column="3"
                                                        Background="{Binding ColorBadgeFondo}"
                                                        CornerRadius="12"
                                                        Padding="14,4,14,4"
                                                        HorizontalAlignment="Center"
                                                        VerticalAlignment="Center">
                                                    <TextBlock Text="{Binding EstadoTexto}"
                                                               FontSize="12"
                                                               FontWeight="SemiBold"
                                                               Foreground="{Binding ColorBadgeTexto}"
                                                               HorizontalAlignment="Center"
                                                               VerticalAlignment="Center"/>
                                                </Border>

                                                <!-- Botones de Acción (Desactivar / Activar) -->
                                                <Grid Grid.Column="4" HorizontalAlignment="Center" VerticalAlignment="Center">
                                                    <!-- Botón Desactivar (Contorneado blanco) -->
                                                    <Button Style="{StaticResource OutlinedActionButtonStyle}"
                                                            Content="Desactivar"
                                                            Visibility="{Binding VisibilidadBotonDesactivar}"
                                                            Tag="{Binding}"
                                                            Click="BtnDesactivarSocio_Click"/>

                                                    <!-- Botón Activar (Verde institucional sólido) -->
                                                    <Button Style="{StaticResource SolidGreenActionButtonStyle}"
                                                            Content="Activar"
                                                            Visibility="{Binding VisibilidadBotonActivar}"
                                                            Tag="{Binding}"
                                                            Click="BtnActivarSocio_Click"/>
                                                </Grid>
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>

                            <!-- Panel Sin Resultados -->
                            <StackPanel x:Name="panelSinResultados"
                                        Visibility="Collapsed"
                                        HorizontalAlignment="Center"
                                        Margin="0,32,0,32">
                                <Path Data="M21 21l-4.35-4.35M17 11a6 6 0 1 1-12 0 6 6 0 0 1 12 0z"
                                      Stroke="#9CA3AF"
                                      StrokeThickness="1.5"
                                      Width="28" Height="28"
                                      HorizontalAlignment="Center"
                                      Margin="0,0,0,12"/>
                                <TextBlock Text="No se encontraron socios registrados con ese criterio."
                                           FontSize="14"
                                           Foreground="#6B7280"
                                           HorizontalAlignment="Center"/>
                            </StackPanel>
                        </StackPanel>
                    </Border>
                </Grid>

                <!-- ================= VISTA 2: REGISTRAR SOCIO ================= -->
                <Grid x:Name="gridRegistrarSocio" Visibility="Collapsed">
                    <Grid.RowDefinitions>
                        <!-- Link volver -->
                        <RowDefinition Height="Auto"/>
                        <!-- Título -->
                        <RowDefinition Height="Auto"/>
                        <!-- Subtítulo -->
                        <RowDefinition Height="Auto"/>
                        <!-- Formulario Tarjeta -->
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <!-- 1. Enlace Volver a la Lista -->
                    <Button Grid.Row="0"
                            Style="{StaticResource LinkButtonStyle}"
                            Click="BtnVolverListaSocios_Click"
                            HorizontalAlignment="Left"
                            Margin="0,0,0,16">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <Path Data="M19 12H5 M12 19l-7-7 7-7"
                                  Stroke="#4B5563"
                                  StrokeThickness="1.8"
                                  StrokeStartLineCap="Round"
                                  StrokeEndLineCap="Round"
                                  Stretch="Uniform"
                                  Width="12" Height="12"
                                  VerticalAlignment="Center"
                                  Margin="0,0,8,0"/>
                            <TextBlock Text="Volver a la lista de socios"
                                       FontSize="13.5"
                                       Foreground="#4B5563"
                                       FontWeight="Medium"
                                       VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>

                    <!-- 2. Título -->
                    <TextBlock Grid.Row="1"
                               Text="Registrar Nuevo Socio"
                               FontSize="32"
                               FontWeight="Bold"
                               Foreground="#111827"
                               Margin="0,0,0,6"/>

                    <!-- 3. Subtítulo -->
                    <TextBlock Grid.Row="2"
                               Text="Ingresa los datos del nuevo socio para darlo de alta en el sistema."
                               FontSize="14.5"
                               Foreground="#6B7280"
                               Margin="0,0,0,26"/>

                    <!-- 4. Formulario en Tarjeta -->
                    <Border Grid.Row="3"
                            Background="#FFFFFF"
                            BorderBrush="#E5E7EB"
                            BorderThickness="1"
                            CornerRadius="12"
                            Padding="32,28,32,28">
                        <Border.Effect>
                            <DropShadowEffect Color="#101828"
                                              BlurRadius="12"
                                              ShadowDepth="1"
                                              Direction="270"
                                              Opacity="0.04"/>
                        </Border.Effect>
                        <StackPanel MaxWidth="620" HorizontalAlignment="Left">
                            <!-- Campo 1: Nombre Completo -->
                            <TextBlock Text="Nombre y Apellido *"
                                       FontSize="13.5"
                                       FontWeight="SemiBold"
                                       Foreground="#374151"
                                       Margin="0,0,0,6"/>
                            <TextBox x:Name="txtNuevoNombre"
                                     Style="{StaticResource FormFieldTextBoxStyle}"
                                     Margin="0,0,0,18"/>

                            <!-- Campo 2: DNI -->
                            <TextBlock Text="Documento Nacional de Identidad (DNI) *"
                                       FontSize="13.5"
                                       FontWeight="SemiBold"
                                       Foreground="#374151"
                                       Margin="0,0,0,6"/>
                            <TextBox x:Name="txtNuevoDni"
                                     Style="{StaticResource FormFieldTextBoxStyle}"
                                     Margin="0,0,0,18"
                                     PreviewTextInput="TxtNuevoDni_PreviewTextInput"/>

                            <!-- Campo 3: Email -->
                            <TextBlock Text="Correo Electrónico"
                                       FontSize="13.5"
                                       FontWeight="SemiBold"
                                       Foreground="#374151"
                                       Margin="0,0,0,6"/>
                            <TextBox x:Name="txtNuevoEmail"
                                     Style="{StaticResource FormFieldTextBoxStyle}"
                                     Margin="0,0,0,18"/>

                            <!-- Campo 4: Teléfono -->
                            <TextBlock Text="Teléfono de Contacto"
                                       FontSize="13.5"
                                       FontWeight="SemiBold"
                                       Foreground="#374151"
                                       Margin="0,0,0,6"/>
                            <TextBox x:Name="txtNuevoTelefono"
                                     Style="{StaticResource FormFieldTextBoxStyle}"
                                     Margin="0,0,0,28"/>

                            <!-- Botones de Acción -->
                            <StackPanel Orientation="Horizontal">
                                <Button Content="Guardar Socio"
                                        Style="{StaticResource PrimaryGreenButtonStyle}"
                                        Width="150" Height="42"
                                        FontSize="13.5"
                                        FontWeight="SemiBold"
                                        Margin="0,0,12,0"
                                        Click="BtnGuardarSocio_Click"/>
                                <Button Content="Cancelar"
                                        Style="{StaticResource OutlinedActionButtonStyle}"
                                        Width="100" Height="42"
                                        FontSize="13.5"
                                        Click="BtnVolverListaSocios_Click"/>
                            </StackPanel>
                        </StackPanel>
                    </Border>
                </Grid>

            </Grid>
        </ScrollViewer>
    </Grid>
</Window>

