<Window x:Class="PrestamosWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="Biblioteca - Registrar Préstamo"
        Height="730" Width="1120"
        MinHeight="640" MinWidth="920"
        WindowStartupLocation="CenterScreen"
        Background="#F7F6F2"
        FontFamily="Segoe UI">

    <Window.Resources>
        <!-- Estilo para botones tipo enlace / transparentes -->
        <Style x:Key="LinkButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="BorderElem" Background="{TemplateBinding Background}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="BorderElem" Property="Opacity" Value="0.4"/>
                                <Setter Property="Cursor" Value="Arrow"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Estilo para botones del menú lateral -->
        <Style x:Key="SidebarButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="14,10,14,10"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="HorizontalContentAlignment" Value="Left"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="BorderElem"
                                Background="{TemplateBinding Background}"
                                CornerRadius="8"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="BorderElem" Property="Background" Value="#EDECE7"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Estilo para botón primario verde -->
        <Style x:Key="PrimaryGreenButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="#1D3B31"/>
            <Setter Property="Foreground" Value="#FFFFFF"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="BtnBorder"
                                Background="{TemplateBinding Background}"
                                CornerRadius="8"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="BtnBorder" Property="Background" Value="#254A3E"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="BtnBorder" Property="Background" Value="#142821"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <!-- Barra Lateral Izquierda -->
            <ColumnDefinition Width="225"/>
            <!-- Área Principal de Contenido -->
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- ================= PANEL LATERAL ================= -->
        <Border Grid.Column="0"
                Background="#F7F6F2"
                BorderBrush="#E5E7EB"
                BorderThickness="0,0,1,0">
            <Grid Margin="20,22,20,22">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- Header de Marca (Logo y Título) -->
                <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="4,0,0,32">
                    <Border Width="38" Height="38"
                            Background="#1D3B31"
                            CornerRadius="8"
                            VerticalAlignment="Center">
                        <Path Data="M3 4.5A2.5 2.5 0 0 1 5.5 2H10a3 3 0 0 1 3 3v13.5a2.5 2.5 0 0 0-2.5-2H5.5A2.5 2.5 0 0 0 3 19V4.5z M21 4.5A2.5 2.5 0 0 0 18.5 2H14a3 3 0 0 0-3 3v13.5a2.5 2.5 0 0 1 2.5-2h5A2.5 2.5 0 0 1 21 19V4.5z"
                              Stroke="#FFFFFF"
                              StrokeThickness="1.6"
                              Fill="Transparent"
                              StrokeStartLineCap="Round"
                              StrokeEndLineCap="Round"
                              StrokeLineJoin="Round"
                              Stretch="Uniform"
                              Width="18" Height="18"
                              HorizontalAlignment="Center"
                              VerticalAlignment="Center"/>
                    </Border>
                    <StackPanel Margin="12,0,0,0" VerticalAlignment="Center">
                        <TextBlock Text="Biblioteca"
                                   FontSize="15"
                                   FontWeight="Bold"
                                   Foreground="#111827"/>
                        <TextBlock Text="Sistema de gestión"
                                   FontSize="11.5"
                                   Foreground="#6B7280"
                                   Margin="0,1,0,0"/>
                    </StackPanel>
                </StackPanel>

                <!-- Menú de Navegación Lateral -->
                <StackPanel Grid.Row="1" Margin="0,4,0,0">
                    <!-- Opción 1: Lista de prestamos -->
                    <Button x:Name="btnNavListaPrestamos"
                            Style="{StaticResource SidebarButtonStyle}"
                            Margin="0,0,0,6"
                            Click="BtnListaPrestamos_Click">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <!-- Icono de lista -->
                            <Path x:Name="iconNavListaPrestamos"
                                  Data="M3 6h2 M9 6h12 M3 12h2 M9 12h12 M3 18h2 M9 18h12"
                                  Stroke="#4B5563"
                                  StrokeThickness="1.8"
                                  StrokeStartLineCap="Round"
                                  StrokeEndLineCap="Round"
                                  Stretch="Uniform"
                                  Width="15" Height="15"
                                  Margin="0,0,10,0"
                                  VerticalAlignment="Center"/>
                            <TextBlock x:Name="textNavListaPrestamos"
                                       Text="Lista de prestamos"
                                       FontSize="13.5"
                                       Foreground="#4B5563"
                                       VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>

                    <!-- Opción 2: Registrar Prestamo -->
                    <Button x:Name="btnNavRegistrarPrestamo"
                            Style="{StaticResource SidebarButtonStyle}"
                            Background="#EBF3EF"
                            Margin="0,0,0,6"
                            Click="BtnNavRegistrarPrestamo_Click">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <!-- Icono badge con cruz verde oscuro -->
                            <Path x:Name="iconNavRegistrarPrestamo"
                                  Data="M19 3H5a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2V5a2 2 0 0 0-2-2z M12 8v8 M8 12h8"
                                  Stroke="#1D3B31"
                                  StrokeThickness="1.8"
                                  StrokeStartLineCap="Round"
                                  StrokeEndLineCap="Round"
                                  Stretch="Uniform"
                                  Width="15" Height="15"
                                  Margin="0,0,10,0"
                                  VerticalAlignment="Center"/>
                            <TextBlock x:Name="textNavRegistrarPrestamo"
                                       Text="Registrar Prestamo"
                                       FontSize="13.5"
                                       FontWeight="SemiBold"
                                       Foreground="#1D3B31"
                                       VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                </StackPanel>

                <!-- Pie de Menú Lateral -->
                <TextBlock Grid.Row="2"
                           Text="Biblioteca · Gestión bibliotecaria"
                           FontSize="11.5"
                           Foreground="#9CA3AF"
                           Margin="6,0,0,4"/>
            </Grid>
        </Border>

        <!-- ================= CONTENIDO PRINCIPAL ================= -->
        <ScrollViewer Grid.Column="1"
                      x:Name="scrollPrincipal"
                      VerticalScrollBarVisibility="Auto"
                      HorizontalScrollBarVisibility="Disabled">
            <Grid Margin="48,26,48,36"
                  MaxWidth="960"
                  HorizontalAlignment="Stretch">

                <!-- ================= MÓDULO: LISTA DE PRESTAMOS ================= -->
                <Grid x:Name="gridListaPrestamos" Visibility="Collapsed">
                    <Grid.RowDefinitions>
                        <!-- Link volver -->
                        <RowDefinition Height="Auto"/>
                        <!-- Título -->
                        <RowDefinition Height="Auto"/>
                        <!-- Subtítulo -->
                        <RowDefinition Height="Auto"/>
                        <!-- Barra de Búsqueda -->
                        <RowDefinition Height="Auto"/>
                        <!-- Tabla de Préstamos -->
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <!-- 1. Enlace Menú Principal -->
                    <Button Grid.Row="0"
                            Style="{StaticResource LinkButtonStyle}"
                            Click="BtnVolverMenu_Click"
                            HorizontalAlignment="Left"
                            Margin="0,0,0,16">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <Path Data="M19 12H5 M12 19l-7-7 7-7"
                                  Stroke="#4B5563"
                                  StrokeThickness="1.8"
                                  StrokeStartLineCap="Round"
                                  StrokeEndLineCap="Round"
                                  Stretch="Uniform"
                                  Width="12" Height="12"
                                  VerticalAlignment="Center"
                                  Margin="0,0,8,0"/>
                            <TextBlock Text="Menú principal"
                                       FontSize="13.5"
                                       Foreground="#4B5563"
                                       FontWeight="Medium"
                                       VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>

                    <!-- 2. Título -->
                    <TextBlock Grid.Row="1"
                               Text="Administrar Prestamos"
                               FontSize="32"
                               FontWeight="Bold"
                               Foreground="#111827"
                               Margin="0,0,0,6"/>

                    <!-- 3. Subtítulo -->
                    <TextBlock Grid.Row="2"
                               Text="Consulta los préstamos registrados y sus fechas de devolución."
                               FontSize="14.5"
                               Foreground="#6B7280"
                               Margin="0,0,0,26"/>

                    <!-- 4. Barra de Búsqueda (ancho completo) -->
                    <Border Grid.Row="3"
                            Height="42"
                            Background="#FFFFFF"
                            BorderBrush="#D1D5DB"
                            BorderThickness="1"
                            CornerRadius="8"
                            Padding="14,0,14,0"
                            Margin="0,0,0,24">
                        <Grid VerticalAlignment="Center">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <!-- Icono lupa -->
                            <Path Grid.Column="0"
                                  Data="M21 21l-4.35-4.35M17 11a6 6 0 1 1-12 0 6 6 0 0 1 12 0z"
                                  Stroke="#9CA3AF"
                                  StrokeThickness="1.8"
                                  StrokeStartLineCap="Round"
                                  StrokeEndLineCap="Round"
                                  Stretch="Uniform"
                                  Width="14" Height="14"
                                  Margin="0,0,10,0"
                                  VerticalAlignment="Center"/>

                            <!-- Placeholder -->
                            <TextBlock Grid.Column="1"
                                       x:Name="txtPlaceholderBuscarPrestamos"
                                       Text="Buscar por Socio o Título de libro"
                                       FontSize="13.5"
                                       Foreground="#9CA3AF"
                                       VerticalAlignment="Center"
                                       IsHitTestVisible="False"/>

                            <!-- Input -->
                            <TextBox Grid.Column="1"
                                     x:Name="txtBuscarPrestamos"
                                     BorderThickness="0"
                                     Background="Transparent"
                                     FontSize="13.5"
                                     Foreground="#111827"
                                     VerticalAlignment="Center"
                                     TextChanged="TxtBuscarPrestamos_TextChanged"/>
                        </Grid>
                    </Border>

                    <!-- 5. Tarjeta de Tabla: Lista de préstamos -->
                    <Border Grid.Row="4"
                            Background="#FFFFFF"
                            BorderBrush="#E5E7EB"
                            BorderThickness="1"
                            CornerRadius="12">
                        <Border.Effect>
                            <DropShadowEffect Color="#101828"
                                              BlurRadius="12"
                                              ShadowDepth="1"
                                              Direction="270"
                                              Opacity="0.04"/>
                        </Border.Effect>
                        <StackPanel>
                            <!-- Cabecera de la Tarjeta -->
                            <DockPanel Margin="24,20,24,18" LastChildFill="False">
                                <TextBlock DockPanel.Dock="Left"
                                           Text="Lista de prestamos"
                                           FontSize="18"
                                           FontWeight="Bold"
                                           Foreground="#111827"
                                           VerticalAlignment="Center"/>
                                <TextBlock DockPanel.Dock="Right"
                                           x:Name="lblContadorListaPrestamos"
                                           Text="7 préstamos registrados"
                                           FontSize="13.5"
                                           Foreground="#6B7280"
                                           VerticalAlignment="Center"/>
                            </DockPanel>

                            <!-- Cabecera de la Tabla -->
                            <Border Background="#EFF5F1" Padding="24,12,24,12">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="210"/>
                                        <ColumnDefinition Width="140"/>
                                        <ColumnDefinition Width="160"/>
                                        <ColumnDefinition Width="110"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0"
                                               Text="Título del libro"
                                               FontSize="12.5"
                                               FontWeight="SemiBold"
                                               Foreground="#4B5563"/>
                                    <TextBlock Grid.Column="1"
                                               Text="Socio"
                                               FontSize="12.5"
                                               FontWeight="SemiBold"
                                               Foreground="#4B5563"/>
                                    <TextBlock Grid.Column="2"
                                               Text="Fecha de préstamo"
                                               FontSize="12.5"
                                               FontWeight="SemiBold"
                                               Foreground="#4B5563"/>
                                    <TextBlock Grid.Column="3"
                                               Text="Fecha límite de devolución"
                                               FontSize="12.5"
                                               FontWeight="SemiBold"
                                               Foreground="#4B5563"/>
                                    <TextBlock Grid.Column="4"
                                               Text="Acción"
                                               FontSize="12.5"
                                               FontWeight="SemiBold"
                                               Foreground="#4B5563"
                                               HorizontalAlignment="Right"/>
                                </Grid>
                            </Border>

                            <!-- Filas de la Tabla (Préstamos) -->
                            <ItemsControl x:Name="icListaPrestamos">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border BorderBrush="#F3F4F6"
                                                BorderThickness="0,0,0,1"
                                                Padding="24,15,24,15"
                                                Background="Transparent">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="210"/>
                                                    <ColumnDefinition Width="140"/>
                                                    <ColumnDefinition Width="160"/>
                                                    <ColumnDefinition Width="110"/>
                                                </Grid.ColumnDefinitions>

                                                <!-- Título del libro -->
                                                <TextBlock Grid.Column="0"
                                                           Text="{Binding TituloLibro}"
                                                           FontSize="14"
                                                           FontWeight="SemiBold"
                                                           Foreground="#111827"
                                                           VerticalAlignment="Center"
                                                           TextTrimming="CharacterEllipsis"/>

                                                <!-- Socio -->
                                                <TextBlock Grid.Column="1"
                                                           Text="{Binding NombreSocio}"
                                                           FontSize="13.5"
                                                           Foreground="#4B5563"
                                                           VerticalAlignment="Center"
                                                           TextTrimming="CharacterEllipsis"/>

                                                <!-- Fecha de préstamo -->
                                                <TextBlock Grid.Column="2"
                                                           Text="{Binding FechaPrestamoFormateada}"
                                                           FontSize="13.5"
                                                           Foreground="#4B5563"
                                                           VerticalAlignment="Center"/>

                                                <!-- Fecha límite de devolución (Color dinámico: Verde si en plazo, Rojo si venció) -->
                                                <TextBlock Grid.Column="3"
                                                           Text="{Binding FechaLimiteFormateada}"
                                                           FontSize="13.5"
                                                           FontWeight="SemiBold"
                                                           Foreground="{Binding ColorFechaLimite}"
                                                           VerticalAlignment="Center"/>

                                                <!-- Acción: Botón Devolver / Estado Devuelto -->
                                                <Grid Grid.Column="4" HorizontalAlignment="Right" VerticalAlignment="Center">
                                                    <!-- Botón Registrar Devolución -->
                                                    <Button Click="BtnDevolverPrestamo_Click"
                                                            Tag="{Binding}"
                                                            Style="{StaticResource LinkButtonStyle}"
                                                            Visibility="{Binding VisibilidadBotonDevolver}"
                                                            Cursor="Hand">
                                                        <Border Background="#EBF3EF"
                                                                CornerRadius="6"
                                                                Padding="10,5,10,5">
                                                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                                <Path Data="M9 14l-4-4 4-4 M5 10h11a4 4 0 0 1 0 8h-2"
                                                                      Stroke="#1D3B31"
                                                                      StrokeThickness="1.6"
                                                                      StrokeStartLineCap="Round"
                                                                      StrokeEndLineCap="Round"
                                                                      Fill="Transparent"
                                                                      Stretch="Uniform"
                                                                      Width="11" Height="11"
                                                                      Margin="0,0,5,0"
                                                                      VerticalAlignment="Center"/>
                                                                <TextBlock Text="Devolver"
                                                                           FontSize="12.5"
                                                                           FontWeight="SemiBold"
                                                                           Foreground="#1D3B31"
                                                                           VerticalAlignment="Center"/>
                                                            </StackPanel>
                                                        </Border>
                                                    </Button>

                                                    <!-- Indicador Ya Devuelto -->
                                                    <StackPanel Orientation="Horizontal"
                                                                VerticalAlignment="Center"
                                                                Visibility="{Binding VisibilidadTextoDevuelto}">
                                                        <Path Data="M20 6L9 17l-5-5"
                                                              Stroke="#15803D"
                                                              StrokeThickness="2"
                                                              StrokeStartLineCap="Round"
                                                              StrokeEndLineCap="Round"
                                                              Fill="Transparent"
                                                              Stretch="Uniform"
                                                              Width="12" Height="12"
                                                              Margin="0,0,4,0"
                                                              VerticalAlignment="Center"/>
                                                        <TextBlock Text="Devuelto"
                                                                   FontSize="12.5"
                                                                   FontWeight="SemiBold"
                                                                   Foreground="#15803D"
                                                                   VerticalAlignment="Center"/>
                                                    </StackPanel>
                                                </Grid>
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </Border>
                </Grid>

                <!-- ================= PASO 1: SELECCIONAR SOCIO ================= -->
                <Grid x:Name="gridPaso1Socio" Visibility="Visible">
                    <Grid.RowDefinitions>
                        <!-- Link volver -->
                        <RowDefinition Height="Auto"/>
                        <!-- Título -->
                        <RowDefinition Height="Auto"/>
                        <!-- Subtítulo -->
                        <RowDefinition Height="Auto"/>
                        <!-- Barra de Búsqueda y Botón Registrar Socio -->
                        <RowDefinition Height="Auto"/>
                        <!-- Tabla de Socios -->
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <!-- 1. Enlace Menú Principal -->
                    <Button Grid.Row="0"
                            x:Name="btnVolverMenu"
                            Style="{StaticResource LinkButtonStyle}"
                            Click="BtnVolverMenu_Click"
                            HorizontalAlignment="Left"
                            Margin="0,0,0,16">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <Path Data="M19 12H5 M12 19l-7-7 7-7"
                                  Stroke="#4B5563"
                                  StrokeThickness="1.8"
                                  StrokeStartLineCap="Round"
                                  StrokeEndLineCap="Round"
                                  Stretch="Uniform"
                                  Width="12" Height="12"
                                  VerticalAlignment="Center"
                                  Margin="0,0,8,0"/>
                            <TextBlock Text="Menú principal"
                                       FontSize="13.5"
                                       Foreground="#4B5563"
                                       FontWeight="Medium"
                                       VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>

                    <!-- 2. Título -->
                    <TextBlock Grid.Row="1"
                               Text="Registrar Prestamo"
                               FontSize="32"
                               FontWeight="Bold"
                               Foreground="#111827"
                               Margin="0,0,0,6"/>

                    <!-- 3. Subtítulo Paso 1 -->
                    <TextBlock Grid.Row="2"
                               Text="Paso 1: selecciona el socio al que se registrará el préstamo."
                               FontSize="14.5"
                               Foreground="#6B7280"
                               Margin="0,0,0,26"/>

                    <!-- 4. Filtro por DNI y Botón Registrar nuevo socio -->
                    <Grid Grid.Row="3" Margin="0,0,0,24">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <!-- Buscar por DNI o Nombre -->
                        <StackPanel Grid.Column="0">
                            <TextBlock Text="Buscar por DNI o Nombre"
                                       FontSize="13.5"
                                       FontWeight="SemiBold"
                                       Foreground="#111827"
                                       Margin="0,0,0,8"/>

                            <!-- Cuadro de texto con lupa -->
                            <Border Width="340" Height="42"
                                    Background="#FFFFFF"
                                    BorderBrush="#D1D5DB"
                                    BorderThickness="1"
                                    CornerRadius="8"
                                    Padding="12,0,12,0">
                                <Grid VerticalAlignment="Center">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>

                                    <!-- Icono lupa -->
                                    <Path Grid.Column="0"
                                          Data="M21 21l-4.35-4.35M17 11a6 6 0 1 1-12 0 6 6 0 0 1 12 0z"
                                          Stroke="#9CA3AF"
                                          StrokeThickness="1.8"
                                          StrokeStartLineCap="Round"
                                          StrokeEndLineCap="Round"
                                          Stretch="Uniform"
                                          Width="14" Height="14"
                                          Margin="0,0,10,0"
                                          VerticalAlignment="Center"/>

                                    <!-- Placeholder -->
                                    <TextBlock Grid.Column="1"
                                               x:Name="txtPlaceholderDni"
                                               Text="Ingresar DNI o Nombre"
                                               FontSize="13.5"
                                               Foreground="#9CA3AF"
                                               VerticalAlignment="Center"
                                               IsHitTestVisible="False"/>

                                    <!-- Input -->
                                    <TextBox Grid.Column="1"
                                             x:Name="txtBuscarDni"
                                             BorderThickness="0"
                                             Background="Transparent"
                                             FontSize="13.5"
                                             Foreground="#111827"
                                             VerticalAlignment="Center"
                                             TextChanged="TxtBuscarDni_TextChanged"/>
                                </Grid>
                            </Border>
                        </StackPanel>

                        <!-- Botón Registrar nuevo socio -->
                        <Button Grid.Column="2"
                                x:Name="btnRegistrarNuevoSocio"
                                Style="{StaticResource PrimaryGreenButtonStyle}"
                                Click="BtnRegistrarNuevoSocio_Click"
                                VerticalAlignment="Bottom"
                                Height="42"
                                Padding="18,0,18,0">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <!-- Icono persona con + -->
                                <Path Data="M13 18v-1.5a3.5 3.5 0 0 0-3.5-3.5h-4A3.5 3.5 0 0 0 2 16.5V18 M7.5 9.5a3.5 3.5 0 1 0 0-7 3.5 3.5 0 0 0 0 7z M18 8v6 M15 11h6"
                                      Stroke="#FFFFFF"
                                      StrokeThickness="1.8"
                                      StrokeStartLineCap="Round"
                                      StrokeEndLineCap="Round"
                                      StrokeLineJoin="Round"
                                      Fill="Transparent"
                                      Stretch="Uniform"
                                      Width="14" Height="14"
                                      Margin="0,0,8,0"
                                      VerticalAlignment="Center"/>
                                <TextBlock Text="Registrar nuevo socio"
                                           FontSize="13.5"
                                           FontWeight="SemiBold"
                                           VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>
                    </Grid>

                    <!-- 5. Tarjeta de Tabla: Seleccionar socio -->
                    <Border Grid.Row="4"
                            Background="#FFFFFF"
                            BorderBrush="#E5E7EB"
                            BorderThickness="1"
                            CornerRadius="12">
                        <Border.Effect>
                            <DropShadowEffect Color="#101828"
                                              BlurRadius="12"
                                              ShadowDepth="1"
                                              Direction="270"
                                              Opacity="0.04"/>
                        </Border.Effect>
                        <StackPanel>
                            <!-- Cabecera de la Tarjeta -->
                            <DockPanel Margin="24,20,24,18" LastChildFill="False">
                                <TextBlock DockPanel.Dock="Left"
                                           Text="Seleccionar socio"
                                           FontSize="18"
                                           FontWeight="Bold"
                                           Foreground="#111827"
                                           VerticalAlignment="Center"/>
                                <TextBlock DockPanel.Dock="Right"
                                           x:Name="lblContadorSocios"
                                           Text="7 socios registrados"
                                           FontSize="13.5"
                                           Foreground="#6B7280"
                                           VerticalAlignment="Center"/>
                            </DockPanel>

                            <!-- Cabecera de la Tabla -->
                            <Border Background="#EFF5F1" Padding="24,12,24,12">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="220"/>
                                        <ColumnDefinition Width="130"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0"
                                               Text="Nombre y apellido"
                                               FontSize="12.5"
                                               FontWeight="SemiBold"
                                               Foreground="#4B5563"/>
                                    <TextBlock Grid.Column="1"
                                               Text="DNI"
                                               FontSize="12.5"
                                               FontWeight="SemiBold"
                                               Foreground="#4B5563"/>
                                    <TextBlock Grid.Column="2"
                                               Text="Acción"
                                               FontSize="12.5"
                                               FontWeight="SemiBold"
                                               Foreground="#4B5563"
                                               HorizontalAlignment="Right"/>
                                </Grid>
                            </Border>

                            <!-- Filas de la Tabla (Socios) -->
                            <ItemsControl x:Name="icSocios">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border BorderBrush="#F3F4F6"
                                                BorderThickness="0,0,0,1"
                                                Padding="24,15,24,15"
                                                Background="Transparent">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="220"/>
                                                    <ColumnDefinition Width="130"/>
                                                </Grid.ColumnDefinitions>

                                                <!-- Nombre y Apellido -->
                                                <TextBlock Grid.Column="0"
                                                           Text="{Binding NombreCompleto}"
                                                           FontSize="14"
                                                           FontWeight="SemiBold"
                                                           Foreground="#111827"
                                                           VerticalAlignment="Center"/>

                                                <!-- DNI -->
                                                <TextBlock Grid.Column="1"
                                                           Text="{Binding DniFormateado}"
                                                           FontSize="13.5"
                                                           Foreground="#4B5563"
                                                           VerticalAlignment="Center"/>

                                                <!-- Botón Seleccionar -> -->
                                                <Button Grid.Column="2"
                                                        Click="BtnSeleccionarSocio_Click"
                                                        Tag="{Binding}"
                                                        Style="{StaticResource LinkButtonStyle}"
                                                        HorizontalAlignment="Right"
                                                        VerticalAlignment="Center">
                                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                        <TextBlock Text="Seleccionar"
                                                                   FontSize="13.5"
                                                                   FontWeight="SemiBold"
                                                                   Foreground="#1D3B31"
                                                                   Margin="0,0,6,0"
                                                                   VerticalAlignment="Center"/>
                                                        <Path Data="M5 12h14 M12 5l7 7-7 7"
                                                              Stroke="#1D3B31"
                                                              StrokeThickness="1.8"
                                                              StrokeStartLineCap="Round"
                                                              StrokeEndLineCap="Round"
                                                              Stretch="Uniform"
                                                              Width="11" Height="11"
                                                              VerticalAlignment="Center"/>
                                                    </StackPanel>
                                                </Button>
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </Border>
                </Grid>

                <!-- ================= PASO 2: SELECCIONAR LIBRO ================= -->
                <Grid x:Name="gridPaso2Libro" Visibility="Collapsed">
                    <Grid.RowDefinitions>
                        <!-- Link volver -->
                        <RowDefinition Height="Auto"/>
                        <!-- Título -->
                        <RowDefinition Height="Auto"/>
                        <!-- Subtítulo -->
                        <RowDefinition Height="Auto"/>
                        <!-- Barra de Búsqueda -->
                        <RowDefinition Height="Auto"/>
                        <!-- Tabla de Libros -->
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <!-- 1. Enlace Menú Principal -->
                    <Button Grid.Row="0"
                            x:Name="btnVolverMenuPaso2"
                            Style="{StaticResource LinkButtonStyle}"
                            Click="BtnVolverMenu_Click"
                            HorizontalAlignment="Left"
                            Margin="0,0,0,16">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <Path Data="M19 12H5 M12 19l-7-7 7-7"
                                  Stroke="#4B5563"
                                  StrokeThickness="1.8"
                                  StrokeStartLineCap="Round"
                                  StrokeEndLineCap="Round"
                                  Stretch="Uniform"
                                  Width="12" Height="12"
                                  VerticalAlignment="Center"
                                  Margin="0,0,8,0"/>
                            <TextBlock Text="Menú principal"
                                       FontSize="13.5"
                                       Foreground="#4B5563"
                                       FontWeight="Medium"
                                       VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>

                    <!-- 2. Título -->
                    <TextBlock Grid.Row="1"
                               Text="Registrar Prestamo"
                               FontSize="32"
                               FontWeight="Bold"
                               Foreground="#111827"
                               Margin="0,0,0,6"/>

                    <!-- 3. Subtítulo Paso 2 -->
                    <TextBlock Grid.Row="2"
                               Text="Paso 2: selecciona el libro que se registrará en el préstamo."
                               FontSize="14.5"
                               Foreground="#6B7280"
                               Margin="0,0,0,26"/>

                    <!-- 4. Filtro por ISBN, Título o Autor -->
                    <StackPanel Grid.Row="3" Margin="0,0,0,24">
                        <TextBlock Text="Buscar por ISBN, Título o Autor"
                                   FontSize="13.5"
                                   FontWeight="SemiBold"
                                   Foreground="#111827"
                                   Margin="0,0,0,8"/>

                        <!-- Cuadro de texto con lupa -->
                        <Border Width="380" Height="42"
                                HorizontalAlignment="Left"
                                Background="#FFFFFF"
                                BorderBrush="#D1D5DB"
                                BorderThickness="1"
                                CornerRadius="8"
                                Padding="12,0,12,0">
                            <Grid VerticalAlignment="Center">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>

                                <!-- Icono lupa -->
                                <Path Grid.Column="0"
                                      Data="M21 21l-4.35-4.35M17 11a6 6 0 1 1-12 0 6 6 0 0 1 12 0z"
                                      Stroke="#9CA3AF"
                                      StrokeThickness="1.8"
                                      StrokeStartLineCap="Round"
                                      StrokeEndLineCap="Round"
                                      Stretch="Uniform"
                                      Width="14" Height="14"
                                      Margin="0,0,10,0"
                                      VerticalAlignment="Center"/>

                                <!-- Placeholder -->
                                <TextBlock Grid.Column="1"
                                           x:Name="txtPlaceholderLibro"
                                           Text="Ingresa el ISBN, título o autor del libro"
                                           FontSize="13.5"
                                           Foreground="#9CA3AF"
                                           VerticalAlignment="Center"
                                           IsHitTestVisible="False"/>

                                <!-- Input -->
                                <TextBox Grid.Column="1"
                                         x:Name="txtBuscarLibro"
                                         BorderThickness="0"
                                         Background="Transparent"
                                         FontSize="13.5"
                                         Foreground="#111827"
                                         VerticalAlignment="Center"
                                         TextChanged="TxtBuscarLibro_TextChanged"/>
                            </Grid>
                        </Border>
                    </StackPanel>

                    <!-- 5. Tarjeta de Tabla: Seleccionar libro -->
                    <Border Grid.Row="4"
                            Background="#FFFFFF"
                            BorderBrush="#E5E7EB"
                            BorderThickness="1"
                            CornerRadius="12">
                        <Border.Effect>
                            <DropShadowEffect Color="#101828"
                                              BlurRadius="12"
                                              ShadowDepth="1"
                                              Direction="270"
                                              Opacity="0.04"/>
                        </Border.Effect>
                        <StackPanel>
                            <!-- Cabecera de la Tarjeta -->
                            <DockPanel Margin="24,20,24,18" LastChildFill="False">
                                <TextBlock DockPanel.Dock="Left"
                                           Text="Seleccionar libro"
                                           FontSize="18"
                                           FontWeight="Bold"
                                           Foreground="#111827"
                                           VerticalAlignment="Center"/>
                                <TextBlock DockPanel.Dock="Right"
                                           x:Name="lblContadorLibros"
                                           Text="7 libros registrados"
                                           FontSize="13.5"
                                           Foreground="#6B7280"
                                           VerticalAlignment="Center"/>
                            </DockPanel>

                            <!-- Cabecera de la Tabla -->
                            <Border Background="#EFF5F1" Padding="24,12,24,12">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="210"/>
                                        <ColumnDefinition Width="160"/>
                                        <ColumnDefinition Width="140"/>
                                        <ColumnDefinition Width="110"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0"
                                               Text="Título del libro"
                                               FontSize="12.5"
                                               FontWeight="SemiBold"
                                               Foreground="#4B5563"/>
                                    <TextBlock Grid.Column="1"
                                               Text="Autor"
                                               FontSize="12.5"
                                               FontWeight="SemiBold"
                                               Foreground="#4B5563"/>
                                    <TextBlock Grid.Column="2"
                                               Text="ISBN"
                                               FontSize="12.5"
                                               FontWeight="SemiBold"
                                               Foreground="#4B5563"/>
                                    <TextBlock Grid.Column="3"
                                               Text="Stock disponible"
                                               FontSize="12.5"
                                               FontWeight="SemiBold"
                                               Foreground="#4B5563"/>
                                    <TextBlock Grid.Column="4"
                                               Text="Acción"
                                               FontSize="12.5"
                                               FontWeight="SemiBold"
                                               Foreground="#4B5563"
                                               HorizontalAlignment="Right"/>
                                </Grid>
                            </Border>

                            <!-- Filas de la Tabla (Libros) -->
                            <ItemsControl x:Name="icLibros">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border BorderBrush="#F3F4F6"
                                                BorderThickness="0,0,0,1"
                                                Padding="24,15,24,15"
                                                Background="Transparent">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="210"/>
                                                    <ColumnDefinition Width="160"/>
                                                    <ColumnDefinition Width="140"/>
                                                    <ColumnDefinition Width="110"/>
                                                </Grid.ColumnDefinitions>

                                                <!-- Título del libro -->
                                                <TextBlock Grid.Column="0"
                                                           Text="{Binding Titulo}"
                                                           FontSize="14"
                                                           FontWeight="SemiBold"
                                                           Foreground="#111827"
                                                           VerticalAlignment="Center"
                                                           TextTrimming="CharacterEllipsis"/>

                                                <!-- Autor -->
                                                <TextBlock Grid.Column="1"
                                                           Text="{Binding Autor}"
                                                           FontSize="13.5"
                                                           Foreground="#4B5563"
                                                           VerticalAlignment="Center"
                                                           TextTrimming="CharacterEllipsis"/>

                                                <!-- ISBN -->
                                                <TextBlock Grid.Column="2"
                                                           Text="{Binding IsbnFormateado}"
                                                           FontSize="13.5"
                                                           Foreground="#4B5563"
                                                           VerticalAlignment="Center"/>

                                                <!-- Stock disponible -->
                                                <TextBlock Grid.Column="3"
                                                           Text="{Binding StockDisponibleTexto}"
                                                           FontSize="13.5"
                                                           FontWeight="SemiBold"
                                                           Foreground="{Binding ColorStock}"
                                                           VerticalAlignment="Center"/>

                                                <!-- Botón Seleccionar -> -->
                                                <Button Grid.Column="4"
                                                        Click="BtnSeleccionarLibro_Click"
                                                        Tag="{Binding}"
                                                        IsEnabled="{Binding TieneStock}"
                                                        Style="{StaticResource LinkButtonStyle}"
                                                        HorizontalAlignment="Right"
                                                        VerticalAlignment="Center">
                                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                        <TextBlock Text="Seleccionar"
                                                                   FontSize="13.5"
                                                                   FontWeight="SemiBold"
                                                                   Foreground="{Binding ColorBotonSeleccionar}"
                                                                   Margin="0,0,6,0"
                                                                   VerticalAlignment="Center"/>
                                                        <Path Data="M5 12h14 M12 5l7 7-7 7"
                                                              Stroke="{Binding ColorBotonSeleccionar}"
                                                              StrokeThickness="1.8"
                                                              StrokeStartLineCap="Round"
                                                              StrokeEndLineCap="Round"
                                                              Stretch="Uniform"
                                                              Width="11" Height="11"
                                                              VerticalAlignment="Center"/>
                                                    </StackPanel>
                                                </Button>
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </Border>
                </Grid>

                <!-- ================= PASO 3: SELECCIONAR PLAZO ================= -->
                <Grid x:Name="gridPaso3Plazo" Visibility="Collapsed">
                    <Grid.RowDefinitions>
                        <!-- Link volver menú -->
                        <RowDefinition Height="Auto"/>
                        <!-- Título -->
                        <RowDefinition Height="Auto"/>
                        <!-- Subtítulo -->
                        <RowDefinition Height="Auto"/>
                        <!-- Tarjeta Vista Previa del Préstamo -->
                        <RowDefinition Height="Auto"/>
                        <!-- Tarjeta Seleccionar Plazo -->
                        <RowDefinition Height="Auto"/>
                        <!-- Barra de Acciones Inferior -->
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <!-- 1. Enlace Menú Principal -->
                    <Button Grid.Row="0"
                            Style="{StaticResource LinkButtonStyle}"
                            Click="BtnVolverMenu_Click"
                            HorizontalAlignment="Left"
                            Margin="0,0,0,16">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <Path Data="M19 12H5 M12 19l-7-7 7-7"
                                  Stroke="#4B5563"
                                  StrokeThickness="1.8"
                                  StrokeStartLineCap="Round"
                                  StrokeEndLineCap="Round"
                                  Stretch="Uniform"
                                  Width="12" Height="12"
                                  VerticalAlignment="Center"
                                  Margin="0,0,8,0"/>
                            <TextBlock Text="Menú principal"
                                       FontSize="13.5"
                                       Foreground="#4B5563"
                                       FontWeight="Medium"
                                       VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>

                    <!-- 2. Título -->
                    <TextBlock Grid.Row="1"
                               Text="Registrar Prestamo"
                               FontSize="32"
                               FontWeight="Bold"
                               Foreground="#111827"
                               Margin="0,0,0,6"/>

                    <!-- 3. Subtítulo Paso 3 -->
                    <TextBlock Grid.Row="2"
                               Text="Paso 3: selecciona el plazo del préstamo y revisa los datos antes de registrar."
                               FontSize="14.5"
                               Foreground="#6B7280"
                               Margin="0,0,0,26"/>

                    <!-- 4. Tarjeta Vista Previa del Préstamo -->
                    <Border Grid.Row="3"
                            Background="#FFFFFF"
                            BorderBrush="#E5E7EB"
                            BorderThickness="1"
                            CornerRadius="12"
                            Margin="0,0,0,24">
                        <Border.Effect>
                            <DropShadowEffect Color="#101828" BlurRadius="12" ShadowDepth="1" Direction="270" Opacity="0.04"/>
                        </Border.Effect>
                        <StackPanel>
                            <!-- Cabecera -->
                            <Border Padding="24,18,24,18" BorderBrush="#E5E7EB" BorderThickness="0,0,0,1">
                                <TextBlock Text="Vista previa del préstamo"
                                           FontSize="17"
                                           FontWeight="Bold"
                                           Foreground="#111827"/>
                            </Border>

                            <!-- Contenido 2 Columnas -->
                            <Grid Margin="24,20,24,24">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="1"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>

                                <!-- Columna Izquierda: Libro seleccionado -->
                                <StackPanel Grid.Column="0" Margin="0,0,24,0">
                                    <TextBlock Text="Libro seleccionado"
                                               FontSize="12"
                                               FontWeight="SemiBold"
                                               Foreground="#6B7280"
                                               Margin="0,0,0,6"/>
                                    <TextBlock x:Name="lblPreviewLibroTitulo"
                                               Text="Cien años de soledad"
                                               FontSize="15"
                                               FontWeight="Bold"
                                               Foreground="#111827"
                                               Margin="0,0,0,4"
                                               TextTrimming="CharacterEllipsis"/>
                                    <TextBlock x:Name="lblPreviewLibroDetalle"
                                               Text="Gabriel García Márquez · ISBN 978-84-376-0494-7"
                                               FontSize="13.5"
                                               Foreground="#6B7280"
                                               TextTrimming="CharacterEllipsis"/>
                                </StackPanel>

                                <!-- Separador vertical -->
                                <Border Grid.Column="1" Background="#E5E7EB"/>

                                <!-- Columna Derecha: Socio seleccionado -->
                                <StackPanel Grid.Column="2" Margin="24,0,0,0">
                                    <TextBlock Text="Socio seleccionado"
                                               FontSize="12"
                                               FontWeight="SemiBold"
                                               Foreground="#6B7280"
                                               Margin="0,0,0,6"/>
                                    <TextBlock x:Name="lblPreviewSocioNombre"
                                               Text="María García López"
                                               FontSize="15"
                                               FontWeight="Bold"
                                               Foreground="#111827"
                                               Margin="0,0,0,4"
                                               TextTrimming="CharacterEllipsis"/>
                                    <TextBlock x:Name="lblPreviewSocioDetalle"
                                               Text="DNI 32.456.789"
                                               FontSize="13.5"
                                               Foreground="#6B7280"/>
                                </StackPanel>
                            </Grid>
                        </StackPanel>
                    </Border>

                    <!-- 5. Tarjeta Seleccionar Plazo -->
                    <Border Grid.Row="4"
                            Background="#FFFFFF"
                            BorderBrush="#E5E7EB"
                            BorderThickness="1"
                            CornerRadius="12"
                            Margin="0,0,0,28">
                        <Border.Effect>
                            <DropShadowEffect Color="#101828" BlurRadius="12" ShadowDepth="1" Direction="270" Opacity="0.04"/>
                        </Border.Effect>
                        <StackPanel>
                            <!-- Cabecera -->
                            <Border Padding="24,18,24,18">
                                <TextBlock Text="Seleccionar plazo"
                                           FontSize="17"
                                           FontWeight="Bold"
                                           Foreground="#111827"/>
                            </Border>

                            <!-- Opciones 7, 14, 30 días -->
                            <Grid Margin="24,0,24,24">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="16"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="16"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>

                                <!-- Opción 1: 7 días -->
                                <Border x:Name="borderPlazo7"
                                        Grid.Column="0"
                                        Background="#FFFFFF"
                                        BorderBrush="#E5E7EB"
                                        BorderThickness="1"
                                        CornerRadius="8"
                                        Padding="18,14,18,14"
                                        Cursor="Hand"
                                        MouseLeftButtonDown="BorderPlazo7_MouseDown">
                                    <RadioButton x:Name="rbPlazo7"
                                                 GroupName="PlazoPrestamo"
                                                 Content="7 días"
                                                 FontSize="14"
                                                 FontWeight="SemiBold"
                                                 Foreground="#111827"
                                                 VerticalAlignment="Center"
                                                 Checked="Plazo_Checked"/>
                                </Border>

                                <!-- Opción 2: 14 días (Seleccionada por defecto) -->
                                <Border x:Name="borderPlazo14"
                                        Grid.Column="2"
                                        Background="#EFF5F1"
                                        BorderBrush="#1D3B31"
                                        BorderThickness="1"
                                        CornerRadius="8"
                                        Padding="18,14,18,14"
                                        Cursor="Hand"
                                        MouseLeftButtonDown="BorderPlazo14_MouseDown">
                                    <RadioButton x:Name="rbPlazo14"
                                                 GroupName="PlazoPrestamo"
                                                 Content="14 días"
                                                 IsChecked="True"
                                                 FontSize="14"
                                                 FontWeight="SemiBold"
                                                 Foreground="#111827"
                                                 VerticalAlignment="Center"
                                                 Checked="Plazo_Checked"/>
                                </Border>

                                <!-- Opción 3: 30 días -->
                                <Border x:Name="borderPlazo30"
                                        Grid.Column="4"
                                        Background="#FFFFFF"
                                        BorderBrush="#E5E7EB"
                                        BorderThickness="1"
                                        CornerRadius="8"
                                        Padding="18,14,18,14"
                                        Cursor="Hand"
                                        MouseLeftButtonDown="BorderPlazo30_MouseDown">
                                    <RadioButton x:Name="rbPlazo30"
                                                 GroupName="PlazoPrestamo"
                                                 Content="30 días"
                                                 FontSize="14"
                                                 FontWeight="SemiBold"
                                                 Foreground="#111827"
                                                 VerticalAlignment="Center"
                                                 Checked="Plazo_Checked"/>
                                </Border>
                            </Grid>
                        </StackPanel>
                    </Border>

                    <!-- 6. Acciones: Volver a seleccionar libro / Registrar préstamo -->
                    <DockPanel Grid.Row="5" LastChildFill="False">
                        <!-- Botón Volver a seleccionar libro -->
                        <Button DockPanel.Dock="Left"
                                x:Name="btnVolverPaso2"
                                Style="{StaticResource LinkButtonStyle}"
                                Click="BtnVolverPaso2_Click"
                                VerticalAlignment="Center">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <Path Data="M19 12H5 M12 19l-7-7 7-7"
                                      Stroke="#4B5563"
                                      StrokeThickness="1.8"
                                      StrokeStartLineCap="Round"
                                      StrokeEndLineCap="Round"
                                      Stretch="Uniform"
                                      Width="12" Height="12"
                                      VerticalAlignment="Center"
                                      Margin="0,0,8,0"/>
                                <TextBlock Text="Volver a seleccionar libro"
                                           FontSize="13.5"
                                           Foreground="#4B5563"
                                           FontWeight="Medium"
                                           VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>

                        <!-- Botón Confirmar Préstamo -->
                        <Button DockPanel.Dock="Right"
                                x:Name="btnRegistrarPrestamoFinal"
                                Style="{StaticResource PrimaryGreenButtonStyle}"
                                Click="BtnRegistrarPrestamoFinal_Click"
                                Height="42"
                                Padding="22,0,22,0">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <Path Data="M20 6L9 17l-5-5"
                                      Stroke="#FFFFFF"
                                      StrokeThickness="2"
                                      StrokeStartLineCap="Round"
                                      StrokeEndLineCap="Round"
                                      StrokeLineJoin="Round"
                                      Fill="Transparent"
                                      Stretch="Uniform"
                                      Width="14" Height="14"
                                      Margin="0,0,8,0"
                                      VerticalAlignment="Center"/>
                                <TextBlock Text="Registrar préstamo"
                                           FontSize="13.5"
                                           FontWeight="SemiBold"
                                           VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>
                    </DockPanel>
                </Grid>

                <!-- ================= PASO ÉXITO: MENSAJE CONFIRMACIÓN ================= -->
                <Grid x:Name="gridPasoExito" Visibility="Collapsed">
                    <Border Background="#FFFFFF"
                            BorderBrush="#E5E7EB"
                            BorderThickness="1"
                            CornerRadius="16"
                            Padding="48,42,48,42"
                            HorizontalAlignment="Center"
                            MaxWidth="620"
                            Margin="0,40,0,0">
                        <Border.Effect>
                            <DropShadowEffect Color="#101828" BlurRadius="20" ShadowDepth="2" Direction="270" Opacity="0.06"/>
                        </Border.Effect>
                        <StackPanel HorizontalAlignment="Center">
                            <!-- Icono Éxito Verde -->
                            <Border Width="64" Height="64"
                                    Background="#EBF3EF"
                                    CornerRadius="32"
                                    HorizontalAlignment="Center"
                                    Margin="0,0,0,20">
                                <Path Data="M20 6L9 17l-5-5"
                                      Stroke="#1D3B31"
                                      StrokeThickness="2.8"
                                      StrokeStartLineCap="Round"
                                      StrokeEndLineCap="Round"
                                      StrokeLineJoin="Round"
                                      Fill="Transparent"
                                      Stretch="Uniform"
                                      Width="26" Height="26"
                                      HorizontalAlignment="Center"
                                      VerticalAlignment="Center"/>
                            </Border>

                            <TextBlock Text="¡Préstamo Registrado con Éxito!"
                                       FontSize="22"
                                       FontWeight="Bold"
                                       Foreground="#111827"
                                       HorizontalAlignment="Center"
                                       Margin="0,0,0,10"/>

                            <TextBlock x:Name="lblExitoMensaje"
                                       Text="El préstamo ha sido registrado correctamente en el sistema."
                                       FontSize="14"
                                       Foreground="#6B7280"
                                       TextAlignment="Center"
                                       TextWrapping="Wrap"
                                       LineHeight="22"
                                       Margin="0,0,0,28"/>

                            <!-- Resumen del Préstamo -->
                            <Border Background="#F9FAFB"
                                    BorderBrush="#E5E7EB"
                                    BorderThickness="1"
                                    CornerRadius="10"
                                    Padding="20,16,20,16"
                                    Margin="0,0,0,32">
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="8"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="8"/>
                                        <RowDefinition Height="Auto"/>
                                    </Grid.RowDefinitions>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>

                                    <TextBlock Grid.Row="0" Grid.Column="0" Text="Socio:" FontWeight="SemiBold" Foreground="#4B5563" FontSize="13"/>
                                    <TextBlock Grid.Row="0" Grid.Column="1" x:Name="lblExitoSocio" Text="-" Foreground="#111827" FontSize="13" Margin="12,0,0,0"/>

                                    <TextBlock Grid.Row="2" Grid.Column="0" Text="Libro:" FontWeight="SemiBold" Foreground="#4B5563" FontSize="13"/>
                                    <TextBlock Grid.Row="2" Grid.Column="1" x:Name="lblExitoLibro" Text="-" Foreground="#111827" FontSize="13" Margin="12,0,0,0"/>

                                    <TextBlock Grid.Row="4" Grid.Column="0" Text="Fecha límite:" FontWeight="SemiBold" Foreground="#4B5563" FontSize="13"/>
                                    <TextBlock Grid.Row="4" Grid.Column="1" x:Name="lblExitoFechaLimite" Text="-" FontWeight="SemiBold" Foreground="#1D3B31" FontSize="13" Margin="12,0,0,0"/>
                                </Grid>
                            </Border>

                            <!-- Botones de Acción -->
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                <Button x:Name="btnVolverMenuPrestamos"
                                        Style="{StaticResource PrimaryGreenButtonStyle}"
                                        Click="BtnVolverMenuPrestamos_Click"
                                        Height="42"
                                        Padding="22,0,22,0"
                                        Margin="0,0,12,0">
                                    <TextBlock Text="Volver al menú de préstamos" FontSize="13.5" FontWeight="SemiBold"/>
                                </Button>

                                <Button x:Name="btnIrMenuPrincipal"
                                        Style="{StaticResource LinkButtonStyle}"
                                        Click="BtnVolverMenu_Click"
                                        Height="42"
                                        Padding="16,0,16,0">
                                    <TextBlock Text="Menú principal" FontSize="13.5" Foreground="#6B7280" FontWeight="Medium"/>
                                </Button>
                            </StackPanel>
                        </StackPanel>
                    </Border>
                </Grid>
            </Grid>
        </ScrollViewer>
    </Grid>
</Window>

