<Window x:Class="MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Biblioteca"
        mc:Ignorable="d"
        Title="Biblioteca - Sistema de Gestión"
        Height="680" Width="1040"
        MinHeight="600" MinWidth="880"
        WindowStartupLocation="CenterScreen"
        Background="#F7F6F2"
        FontFamily="Segoe UI">

    <Window.Resources>
        <!-- Estilo base para las tarjetas del menú -->
        <Style x:Key="MenuCardButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="#FFFFFF"/>
            <Setter Property="BorderBrush" Value="#E5E7EB"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Setter Property="VerticalContentAlignment" Value="Stretch"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="SnapsToDevicePixels" Value="True"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="CardBorder"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="16"
                                Padding="{TemplateBinding Padding}">
                            <Border.Effect>
                                <DropShadowEffect x:Name="CardShadow"
                                                  Color="#101828"
                                                  BlurRadius="16"
                                                  ShadowDepth="2"
                                                  Direction="270"
                                                  Opacity="0.05"/>
                            </Border.Effect>
                            <ContentPresenter HorizontalAlignment="Stretch" VerticalAlignment="Stretch"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="CardBorder" Property="BorderBrush" Value="#2D5545"/>
                                <Setter TargetName="CardBorder" Property="Effect">
                                    <Setter.Value>
                                        <DropShadowEffect Color="#101828"
                                                          BlurRadius="22"
                                                          ShadowDepth="4"
                                                          Direction="270"
                                                          Opacity="0.12"/>
                                    </Setter.Value>
                                </Setter>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="CardBorder" Property="BorderBrush" Value="#1D3B31"/>
                                <Setter TargetName="CardBorder" Property="Background" Value="#FBFDFB"/>
                                <Setter TargetName="CardBorder" Property="Effect">
                                    <Setter.Value>
                                        <DropShadowEffect Color="#101828"
                                                          BlurRadius="8"
                                                          ShadowDepth="1"
                                                          Direction="270"
                                                          Opacity="0.08"/>
                                    </Setter.Value>
                                </Setter>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <!-- Barra Superior (Header) -->
            <RowDefinition Height="Auto"/>
            <!-- Área Principal (Contenido) -->
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- ================= HEADER SUPERIOR ================= -->
        <Border Grid.Row="0"
                Background="#FFFFFF"
                BorderBrush="#E5E7EB"
                BorderThickness="0,0,0,1"
                Padding="36,14,36,14">
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                <!-- Icono de Biblioteca (Fondo verde oscuro con libro en blanco) -->
                <Border Width="40" Height="40"
                        Background="#1D3B31"
                        CornerRadius="8"
                        VerticalAlignment="Center">
                    <Path Data="M3 4.5A2.5 2.5 0 0 1 5.5 2H10a3 3 0 0 1 3 3v13.5a2.5 2.5 0 0 0-2.5-2H5.5A2.5 2.5 0 0 0 3 19V4.5z M21 4.5A2.5 2.5 0 0 0 18.5 2H14a3 3 0 0 0-3 3v13.5a2.5 2.5 0 0 1 2.5-2h5A2.5 2.5 0 0 1 21 19V4.5z"
                          Stroke="#FFFFFF"
                          StrokeThickness="1.6"
                          Fill="Transparent"
                          StrokeStartLineCap="Round"
                          StrokeEndLineCap="Round"
                          StrokeLineJoin="Round"
                          Stretch="Uniform"
                          Width="19" Height="19"
                          HorizontalAlignment="Center"
                          VerticalAlignment="Center"/>
                </Border>

                <!-- Título y Subtítulo de la App -->
                <StackPanel Margin="14,0,0,0" VerticalAlignment="Center">
                    <TextBlock Text="Biblioteca"
                               FontSize="16"
                               FontWeight="Bold"
                               Foreground="#111827"/>
                    <TextBlock Text="Sistema de gestión"
                               FontSize="12"
                               Foreground="#6B7280"
                               Margin="0,1,0,0"/>
                </StackPanel>
            </StackPanel>
        </Border>

        <!-- ================= CONTENIDO PRINCIPAL ================= -->
        <ScrollViewer Grid.Row="1"
                      VerticalScrollBarVisibility="Auto"
                      HorizontalScrollBarVisibility="Disabled">
            <Grid MaxWidth="1020"
                  Margin="48,40,48,40"
                  HorizontalAlignment="Stretch"
                  VerticalAlignment="Top">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- Títulos y Textos Guía -->
                <StackPanel Grid.Row="0">
                    <TextBlock Text="Biblioteca · Gestión bibliotecaria"
                               FontSize="13"
                               FontWeight="Normal"
                               Foreground="#6B7280"
                               Margin="0,0,0,12"/>
                    <TextBlock Text="Menú principal"
                               FontSize="34"
                               FontWeight="Bold"
                               Foreground="#111827"
                               Margin="0,0,0,8"/>
                    <TextBlock Text="Selecciona una opción para comenzar."
                               FontSize="15"
                               Foreground="#6B7280"
                               Margin="0,0,0,36"/>
                </StackPanel>

                <!-- Tarjetas del Menú (3 columnas) -->
                <Grid Grid.Row="1">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="20"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="20"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <!-- ================= TARJETA 1: ADMINISTRAR SOCIOS ================= -->
                    <Button Grid.Column="0"
                            x:Name="btnSocios"
                            Style="{StaticResource MenuCardButtonStyle}"
                            Click="BtnSocios_Click">
                        <Border Padding="26,26,26,24">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="*"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>

                                <!-- Icono Socios (Fondo Verde Claro) -->
                                <Border Grid.Row="0"
                                        Width="46" Height="46"
                                        Background="#EBF3EF"
                                        CornerRadius="10"
                                        HorizontalAlignment="Left">
                                    <Canvas Width="22" Height="22" HorizontalAlignment="Center" VerticalAlignment="Center">
                                        <!-- Silueta principal (usuario izquierda) -->
                                        <Path Data="M13 18v-1.5a3.5 3.5 0 0 0-3.5-3.5h-4A3.5 3.5 0 0 0 2 16.5V18 M7.5 9.5a3.5 3.5 0 1 0 0-7 3.5 3.5 0 0 0 0 7z"
                                              Stroke="#1D3B31"
                                              StrokeThickness="1.8"
                                              StrokeStartLineCap="Round"
                                              StrokeEndLineCap="Round"
                                              StrokeLineJoin="Round"
                                              Fill="Transparent"/>
                                        <!-- Silueta secundaria (usuario derecha) -->
                                        <Path Data="M16 17v-1a3 3 0 0 0-2.3-2.9 M14 3.5a3 3 0 0 1 0 5.8"
                                              Stroke="#1D3B31"
                                              StrokeThickness="1.8"
                                              StrokeStartLineCap="Round"
                                              StrokeEndLineCap="Round"
                                              StrokeLineJoin="Round"
                                              Fill="Transparent"/>
                                    </Canvas>
                                </Border>

                                <!-- Textos -->
                                <StackPanel Grid.Row="1" Margin="0,22,0,26">
                                    <TextBlock Text="Administrar Socios"
                                               FontSize="18"
                                               FontWeight="Bold"
                                               Foreground="#111827"
                                               Margin="0,0,0,8"/>
                                    <TextBlock Text="Altas, consultas y datos de los socios."
                                               FontSize="13.5"
                                               Foreground="#6B7280"
                                               TextWrapping="Wrap"
                                               LineHeight="20"/>
                                </StackPanel>

                                <!-- Pie de Tarjeta (Ingresar ->) -->
                                <DockPanel Grid.Row="2" LastChildFill="False">
                                    <TextBlock DockPanel.Dock="Left"
                                               Text="Ingresar"
                                               FontSize="13.5"
                                               FontWeight="SemiBold"
                                               Foreground="#1D3B31"
                                               VerticalAlignment="Center"/>
                                    <Path DockPanel.Dock="Right"
                                          Data="M4 10h12 M11 5l5 5-5 5"
                                          Stroke="#1D3B31"
                                          StrokeThickness="1.8"
                                          StrokeStartLineCap="Round"
                                          StrokeEndLineCap="Round"
                                          StrokeLineJoin="Round"
                                          Stretch="Uniform"
                                          Width="14" Height="14"
                                          VerticalAlignment="Center"/>
                                </DockPanel>
                            </Grid>
                        </Border>
                    </Button>

                    <!-- ================= TARJETA 2: ADMINISTRAR LIBROS ================= -->
                    <Button Grid.Column="2"
                            x:Name="btnLibros"
                            Style="{StaticResource MenuCardButtonStyle}"
                            Click="BtnLibros_Click">
                        <Border Padding="26,26,26,24">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="*"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>

                                <!-- Icono Libros (Fondo Verde Claro) -->
                                <Border Grid.Row="0"
                                        Width="46" Height="46"
                                        Background="#EBF3EF"
                                        CornerRadius="10"
                                        HorizontalAlignment="Left">
                                    <Path Data="M3 4.5A2.5 2.5 0 0 1 5.5 2H10a3 3 0 0 1 3 3v13.5a2.5 2.5 0 0 0-2.5-2H5.5A2.5 2.5 0 0 0 3 19V4.5z M21 4.5A2.5 2.5 0 0 0 18.5 2H14a3 3 0 0 0-3 3v13.5a2.5 2.5 0 0 1 2.5-2h5A2.5 2.5 0 0 1 21 19V4.5z"
                                          Stroke="#1D3B31"
                                          StrokeThickness="1.8"
                                          StrokeStartLineCap="Round"
                                          StrokeEndLineCap="Round"
                                          StrokeLineJoin="Round"
                                          Fill="Transparent"
                                          Stretch="Uniform"
                                          Width="20" Height="20"
                                          HorizontalAlignment="Center"
                                          VerticalAlignment="Center"/>
                                </Border>

                                <!-- Textos -->
                                <StackPanel Grid.Row="1" Margin="0,22,0,26">
                                    <TextBlock Text="Administrar Libros"
                                               FontSize="18"
                                               FontWeight="Bold"
                                               Foreground="#111827"
                                               Margin="0,0,0,8"/>
                                    <TextBlock Text="Catálogo y disponibilidad de ejemplares."
                                               FontSize="13.5"
                                               Foreground="#6B7280"
                                               TextWrapping="Wrap"
                                               LineHeight="20"/>
                                </StackPanel>

                                <!-- Pie de Tarjeta (Ingresar ->) -->
                                <DockPanel Grid.Row="2" LastChildFill="False">
                                    <TextBlock DockPanel.Dock="Left"
                                               Text="Ingresar"
                                               FontSize="13.5"
                                               FontWeight="SemiBold"
                                               Foreground="#1D3B31"
                                               VerticalAlignment="Center"/>
                                    <Path DockPanel.Dock="Right"
                                          Data="M4 10h12 M11 5l5 5-5 5"
                                          Stroke="#1D3B31"
                                          StrokeThickness="1.8"
                                          StrokeStartLineCap="Round"
                                          StrokeEndLineCap="Round"
                                          StrokeLineJoin="Round"
                                          Stretch="Uniform"
                                          Width="14" Height="14"
                                          VerticalAlignment="Center"/>
                                </DockPanel>
                            </Grid>
                        </Border>
                    </Button>

                    <!-- ================= TARJETA 3: ADMINISTRAR PRESTAMOS ================= -->
                    <Button Grid.Column="4"
                            x:Name="btnPrestamos"
                            Style="{StaticResource MenuCardButtonStyle}"
                            Click="BtnPrestamos_Click">
                        <Border Padding="26,26,26,24">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="*"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>

                                <!-- Icono Préstamos (Fondo Verde Claro - Flechas Intercambio) -->
                                <Border Grid.Row="0"
                                        Width="46" Height="46"
                                        Background="#EBF3EF"
                                        CornerRadius="10"
                                        HorizontalAlignment="Left">
                                    <Canvas Width="22" Height="22" HorizontalAlignment="Center" VerticalAlignment="Center">
                                        <!-- Flecha Superior hacia la izquierda -->
                                        <Path Data="M7 6l-4 4 4 4 M3 10h16"
                                              Stroke="#1D3B31"
                                              StrokeThickness="1.8"
                                              StrokeStartLineCap="Round"
                                              StrokeEndLineCap="Round"
                                              StrokeLineJoin="Round"
                                              Fill="Transparent"/>
                                        <!-- Flecha Inferior hacia la derecha -->
                                        <Path Data="M15 12l4 4-4 4 M19 16H3"
                                              Stroke="#1D3B31"
                                              StrokeThickness="1.8"
                                              StrokeStartLineCap="Round"
                                              StrokeEndLineCap="Round"
                                              StrokeLineJoin="Round"
                                              Fill="Transparent"/>
                                    </Canvas>
                                </Border>

                                <!-- Textos -->
                                <StackPanel Grid.Row="1" Margin="0,22,0,26">
                                    <TextBlock Text="Administrar Prestamos"
                                               FontSize="18"
                                               FontWeight="Bold"
                                               Foreground="#111827"
                                               Margin="0,0,0,8"/>
                                    <TextBlock Text="Préstamos, devoluciones y vencimientos."
                                               FontSize="13.5"
                                               Foreground="#6B7280"
                                               TextWrapping="Wrap"
                                               LineHeight="20"/>
                                </StackPanel>

                                <!-- Pie de Tarjeta (Ingresar ->) -->
                                <DockPanel Grid.Row="2" LastChildFill="False">
                                    <TextBlock DockPanel.Dock="Left"
                                               Text="Ingresar"
                                               FontSize="13.5"
                                               FontWeight="SemiBold"
                                               Foreground="#1D3B31"
                                               VerticalAlignment="Center"/>
                                    <Path DockPanel.Dock="Right"
                                          Data="M4 10h12 M11 5l5 5-5 5"
                                          Stroke="#1D3B31"
                                          StrokeThickness="1.8"
                                          StrokeStartLineCap="Round"
                                          StrokeEndLineCap="Round"
                                          StrokeLineJoin="Round"
                                          Stretch="Uniform"
                                          Width="14" Height="14"
                                          VerticalAlignment="Center"/>
                                </DockPanel>
                            </Grid>
                        </Border>
                    </Button>
                </Grid>
            </Grid>
        </ScrollViewer>
    </Grid>
</Window>
